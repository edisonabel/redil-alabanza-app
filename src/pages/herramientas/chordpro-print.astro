---
import Layout from '../../layouts/Layout.astro';
import ChordProPrintWorkspace from '../../components/react/ChordProPrintWorkspace';
import { createClient } from '@supabase/supabase-js';
import { applyBetaSongCalibration } from '../../utils/liveDirectorBetaCalibration';
import { getSupabaseServerEnv } from '../../lib/server/supabase-env.js';
import {
  loadRehearsalSongSettings,
  sanitizeRehearsalSongSettings,
} from '../../utils/rehearsalUserSongSettings';
import {
  DEFAULT_CHORD_PRO_PERSONAL_PREFERENCES,
  sanitizeChordProPersonalPreferences,
} from '../../utils/chordProPersonalPreferences.js';

const requestedSongId = Astro.url.searchParams.get('song')?.trim() || '';
const requestedEventId = Astro.url.searchParams.get('event')?.trim() || '';
const requestedPlaylistId = Astro.url.searchParams.get('playlist')?.trim() || '';
const userId = Astro.locals.user?.id || '';
const accessToken = Astro.locals.accessToken || Astro.cookies.get('sb-access-token')?.value || '';

if (!Astro.locals.user || !accessToken) {
  return Astro.redirect('/login');
}

const { supabaseUrl, supabaseAnonKey } = getSupabaseServerEnv();
const supabaseSSR = createClient(supabaseUrl, supabaseAnonKey, {
  global: {
    headers: {
      Authorization: `Bearer ${accessToken}`,
    },
  },
  auth: {
    persistSession: false,
    autoRefreshToken: false,
  },
});
let initialSong: {
  id: string;
  titulo: string;
  artista: string;
  tono: string;
  capo: string;
  targetTone: string;
  initialCapo: number;
  tempo: string;
  time: string;
  chordpro: string;
  sectionMarkers: Array<Record<string, unknown>>;
  eventId: string;
  chartPreferences: ReturnType<typeof sanitizeChordProPersonalPreferences>;
  chartPreferencesRemoteAvailable: boolean;
  chartPreferencesLoadedFromRemote: boolean;
} | null = null;

const NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const LATIN_TO_AMERICAN: Record<string, string> = {
  Do: 'C',
  'Do#': 'C#',
  Reb: 'C#',
  Re: 'D',
  'Re#': 'D#',
  Mib: 'D#',
  Mi: 'E',
  Fa: 'F',
  'Fa#': 'F#',
  Solb: 'F#',
  Sol: 'G',
  'Sol#': 'G#',
  Lab: 'G#',
  La: 'A',
  'La#': 'A#',
  Sib: 'A#',
  Si: 'B',
  Dob: 'B',
};
const FLAT_TO_SHARP: Record<string, string> = { Db: 'C#', Eb: 'D#', Gb: 'F#', Ab: 'G#', Bb: 'A#' };

const normalizeKeyToAmerican = (rawKey = '') => {
  const source = String(rawKey || '').trim();
  if (!source) return '';
  const normalizedSource = source
    .replace(/♯/g, '#')
    .replace(/♭/g, 'b')
    .replace(/\s+/g, '');
  if (LATIN_TO_AMERICAN[normalizedSource]) return LATIN_TO_AMERICAN[normalizedSource];
  const upperRoot = normalizedSource.charAt(0).toUpperCase() + normalizedSource.slice(1);
  const rootMatch = upperRoot.match(/^([A-G][#b]?)/);
  if (!rootMatch) return source;
  return FLAT_TO_SHARP[rootMatch[1]] || rootMatch[1];
};

const transposeTone = (tone = '', steps = 0) => {
  const normalizedTone = normalizeKeyToAmerican(tone);
  const toneIndex = NOTES.indexOf(normalizedTone);
  if (toneIndex === -1) return normalizedTone;
  return NOTES[(toneIndex + steps + 1200) % 12];
};

const resolveInitialChordPro = async (rawValue: unknown) => {
  const value = String(rawValue || '').trim();
  if (!value) return '';

  const looksLikeRemoteText =
    /^https?:\/\//i.test(value) &&
    /\.(txt|pro|cho|chordpro)(\?.*)?$/i.test(value);

  if (!looksLikeRemoteText) return value;

  try {
    const response = await fetch(value);
    if (!response.ok) return value;
    return (await response.text()).trim() || value;
  } catch {
    return value;
  }
};

if (requestedSongId) {
  try {
    const { data: songRow } = await supabaseSSR
      .from('canciones')
      .select('id, titulo, cantante, tonalidad, bpm, chordpro, section_markers')
      .eq('id', requestedSongId)
      .maybeSingle();

    if (songRow) {
      const chordproContent = await resolveInitialChordPro(songRow.chordpro);
      const calibratedSong = applyBetaSongCalibration({
        id: String(songRow.id ?? requestedSongId),
        sectionMarkers: songRow.section_markers,
      });
      let chartPreferences: ReturnType<typeof sanitizeChordProPersonalPreferences> = {
        ...DEFAULT_CHORD_PRO_PERSONAL_PREFERENCES,
        targetTone: '',
        capoFret: 0,
      };
      let chartPreferencesRemoteAvailable = false;
      let chartPreferencesLoadedFromRemote = false;
      if (userId) {
        try {
          const { data: chartRow, error: chartPreferencesError } = await supabaseSSR
            .from('cancion_chart_preferencias_usuario')
            .select('notas_personales, preferencias')
            .eq('perfil_id', userId)
            .eq('cancion_id', String(songRow.id ?? requestedSongId))
            .maybeSingle();
          chartPreferencesRemoteAvailable = !chartPreferencesError;
          if (!chartPreferencesError && chartRow) {
            chartPreferencesLoadedFromRemote = true;
            chartPreferences = sanitizeChordProPersonalPreferences({
              ...(chartRow.preferencias || {}),
              personalNotes: chartRow.notas_personales,
            });
          }
        } catch {
          // The editor can still use local private storage until migration 056 is applied.
        }
      }
      let personalSettings = sanitizeRehearsalSongSettings();

      if (userId && requestedEventId) {
        personalSettings = sanitizeRehearsalSongSettings(await loadRehearsalSongSettings(supabaseSSR, {
          userId,
          eventId: requestedEventId,
          playlistId: requestedPlaylistId,
          songId: String(songRow.id ?? requestedSongId),
        }));
      }

      const originalTone = normalizeKeyToAmerican(songRow.tonalidad || '');
      const targetTone = transposeTone(originalTone, personalSettings.transposeSteps);
      initialSong = {
        id: String(songRow.id ?? requestedSongId),
        titulo: String(songRow.titulo || ''),
        artista: String(songRow.cantante || ''),
        tono: originalTone,
        capo: personalSettings.capoFret > 0 ? String(personalSettings.capoFret) : '',
        targetTone,
        initialCapo: personalSettings.capoFret,
        tempo: String(songRow.bpm || ''),
        time: '',
        chordpro: chordproContent,
        sectionMarkers: Array.isArray(calibratedSong.sectionMarkers) ? calibratedSong.sectionMarkers : [],
        eventId: requestedEventId,
        chartPreferences: {
          ...chartPreferences,
          targetTone: chartPreferences.targetTone || targetTone,
          capoFret: chartPreferences.targetTone || chartPreferences.capoFret > 0
            ? chartPreferences.capoFret
            : personalSettings.capoFret,
        },
        chartPreferencesRemoteAvailable,
        chartPreferencesLoadedFromRemote,
      };
    }
  } catch (error) {
    console.error('ChordPro print workspace preload failed:', error);
  }
}
---

<Layout>
  <div class="mx-auto w-full max-w-[1880px] px-4 pb-3 pt-4 print:hidden lg:px-6 xl:px-8">
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/repertorio"
        data-astro-reload
        aria-label="Volver a repertorio"
        title="Volver a repertorio"
        class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-zinc-200 bg-white text-zinc-600 shadow-sm transition hover:bg-zinc-50 hover:text-zinc-950 sm:w-auto sm:gap-2 sm:px-4"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        <span class="hidden sm:inline text-sm font-bold">Volver a repertorio</span>
      </a>

      <div class="flex min-w-0 items-center gap-3">
        <h1 class="text-[clamp(1.65rem,2vw,2.65rem)] font-black tracking-[-0.05em] text-zinc-950 dark:text-white">
          Hoja lista para imprimir
        </h1>
      </div>
    </div>
  </div>

  {initialSong ? (
    <div style="width: 100%; height: 100vh; min-height: 100vh;">
      <ChordProPrintWorkspace
        client:only="react"
        initialChordProText={initialSong.chordpro}
        initialSectionMarkers={initialSong.sectionMarkers}
        eventId={initialSong.eventId}
        songId={initialSong.id}
        userId={userId}
        initialPersonalPreferences={initialSong.chartPreferences}
        personalPreferencesRemoteAvailable={initialSong.chartPreferencesRemoteAvailable}
        personalPreferencesLoadedFromRemote={initialSong.chartPreferencesLoadedFromRemote}
        initialTitle={initialSong.titulo}
        initialArtist={initialSong.artista}
        initialTargetTone={initialSong.targetTone}
        initialCapo={initialSong.initialCapo}
        initialMetadata={{
          tone: initialSong.tono,
          capo: initialSong.capo,
          tempo: initialSong.tempo,
          time: initialSong.time,
        }}
      />
    </div>
  ) : (
    <section class="mx-auto max-w-2xl px-4 py-16 text-center">
      <p class="text-sm font-black uppercase tracking-[0.2em] text-zinc-400">ChordPro</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-zinc-950">No encontramos la cancion</h1>
      <p class="mt-3 text-base text-zinc-500">
        Esta vista necesita un `song` valido para cargar la hoja de impresion.
      </p>
      <a
        href="/repertorio"
        class="mt-6 inline-flex items-center justify-center rounded-2xl bg-zinc-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-zinc-800"
      >
        Ir a repertorio
      </a>
    </section>
  )}
</Layout>

<style is:global>
@page { margin: 0; size: 8.5in 11in; }
@media print {
  html, body, body.app-shell, body > main.app-safe-main {
    display: block !important;
    width: 8.5in !important;
    height: auto !important;
    max-height: none !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: white !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  body > :not(main.app-safe-main) { display: none !important; }
  .print\:hidden { display: none !important; }
  main.app-safe-main > div, #vista-previa-impresion, #vista-previa-impresion > div,
  .song-sheet-preview-viewport, .song-sheet-preview-sizing, .song-sheet-preview-transform,
  #chordpro-print-sheet {
    position: static !important;
    display: block !important;
    transform: none !important;
    width: 8.5in !important;
    height: auto !important;
    max-height: none !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background: white !important;
  }
}
</style>
