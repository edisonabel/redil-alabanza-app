---
import Layout from '../../layouts/Layout.astro';
import SmartTuner from '../../components/react/SmartTuner';
---

<Layout title="Afinador inteligente | Redil Alabanza">
  <main class="min-h-screen pt-4 md:pt-8">
    <div class="mx-auto mb-6 w-full max-w-5xl px-4">
      <a href="/herramientas" class="mb-5 inline-flex min-h-11 w-max items-center text-content-muted transition-colors hover:text-content focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action/50 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-5 w-5">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Volver a Herramientas
      </a>

      <header class="max-w-3xl">
        <div class="page-title-row mb-3">
          <span class="page-title-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3v18"></path>
              <path d="M5 8v8"></path>
              <path d="M19 6v12"></path>
              <path d="M8.5 5.5v13"></path>
              <path d="M15.5 5.5v13"></path>
            </svg>
          </span>
          <h1 class="page-title text-[2rem] md:text-[3rem]">Afinador inteligente</h1>
        </div>
        <p class="page-subtitle text-sm md:text-lg">
          Afina guitarra o voz y comprueba en tiempo real si cada nota pertenece a la escala elegida.
        </p>
      </header>
    </div>

    <SmartTuner client:only="react" />
  </main>
</Layout>
