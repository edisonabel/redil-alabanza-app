  color: rgb(var(--text-base));
  border: 1px solid rgb(var(--border-base));
  background: rgb(var(--bg-base));
 }

 .team-wizard-primary:hover,
 .team-wizard-secondary:hover {
  transform: translateY(-1px);
 }

 .team-wizard-primary:disabled,
 .team-wizard-secondary:disabled {
  cursor: wait;
  opacity: 0.58;
  transform: none;
 }

 .team-wizard-primary:focus-visible,
 .team-wizard-secondary:focus-visible {
  outline: 3px solid rgb(var(--color-brand) / 0.34);
  outline-offset: 2px;
 }

 html.dark .team-wizard-primary {
  color: rgb(15 23 42);
  background: white;
 }

 html.dark .team-wizard-option-icon--general {
  color: rgb(110 231 183);
 }

 html.dark .team-wizard-option-icon--youth {
  color: rgb(125 211 252);
 }

 html.dark .team-wizard-option-icon--voice {
  color: rgb(196 181 253);
 }

 @media (max-width: 479px) {
  .team-wizard-nav {
   gap: 0.2rem;
   padding-inline: 0.45rem;
  }

  .team-wizard-nav-item {
   min-height: 52px;
   flex-direction: column;
   gap: 0.16rem;
   padding: 0.3rem 0.15rem;
   font-size: 0.59rem;
  }

  .team-wizard-nav-item svg {
   width: 15px;
   height: 15px;
  }
 }

 @media (min-width: 640px) {
  .team-wizard-modal {
   padding: 1rem;
  }

  .team-wizard-panel {
   width: min(720px, 100%);
   height: min(850px, calc(100dvh - 2rem));
   border: 1px solid rgb(255 255 255 / 0.18);
   border-radius: 2rem;
   box-shadow: 0 34px 86px -34px rgb(2 6 23 / 0.82);
  }

  .team-wizard-hero {
   height: 236px;
   flex-basis: 236px;
  }

  .team-wizard-nav {
   padding-inline: 1rem;
  }

  .team-wizard-step {
   padding: 1.4rem 1.35rem 1.75rem;
  }

  .team-wizard-options {
   grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .team-wizard-role-grid {
   grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .team-wizard-vocal-card {
   grid-template-columns: auto minmax(0, 1fr) minmax(190px, 0.8fr);
  }

  .team-wizard-vocal-field {
   grid-column: auto;
  }

  .team-wizard-footer {
   padding-inline: 1.35rem;
  }
 }

 @media (prefers-reduced-motion: reduce) {
  .team-wizard-backdrop,
  .team-wizard-panel,
  .team-wizard-step,
  .team-wizard-progress i,
  .team-wizard-toggle > span {
   transition-duration: 0.01ms !important;
  }
 }
</style>
</Layout>

<script>
 import { supabase } from '../lib/supabase';
 import { isEventRepertoryManagerRoleCode, isHiddenEventAssignmentRoleCode, isTeamAssignableRoleCode } from '../lib/role-permissions.js';
 import { safeHtml } from '../lib/client/html-safety.js';

 // Estado reactivo temporal de la Plantilla de Equipo
 window.tbState = {
 assignments: [] // { rol_id, rol_codigo, perfil_id, perfil_nombre, avatar_url }
 };
 window.appStateRoles = []; // Cache rÃ¡pido para Picker

 const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
 const escapeHtml = (value: unknown) => String(value ?? '')
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/"/g, '&quot;')
  .replace(/'/g, '&#39;');

 const capabilityIconSvg = (roleCode = '') => {
  const code = String(roleCode || '').trim().toLowerCase();
  const svg = (body:string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

  if (code.includes('piano') || code.includes('teclado')) {
   return svg('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 5v8M11 5v8M15 5v8M19 5v8"/><path d="M5 13h14"/>');
  }
  if (code.includes('bateria') || code.includes('caja') || code.includes('cajon')) {
   return svg('<ellipse cx="12" cy="13" rx="7.5" ry="4"/><path d="M4.5 13V8.5c0 2.2 3.4 4 7.5 4s7.5-1.8 7.5-4V13M7 16.2V20M17 16.2V20M8 3l2.3 5M16 3l-2.3 5"/>');
  }
  if (code.includes('guitarra') || code === 'bajo' || code.includes('violin')) {
   return svg('<path d="m15.5 4.5 4 4"/><path d="m14 10 4-4"/><path d="M13.2 9.2c-1.6-1.6-3.7-2-4.8-.9-.7.7-.8 1.7-.4 2.8l-3.3 3.3a3.2 3.2 0 0 0 4.5 4.5l3.3-3.3c1.1.4 2.1.3 2.8-.4 1.1-1.1.7-3.2-.9-4.8Z"/><circle cx="8.2" cy="15.8" r="1.2"/>');
  }
  if (code.includes('voz') || code.includes('vocal') || code.includes('talkback') || code.includes('lider_alabanza')) {
   return svg('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M9 21h6"/>');
  }
  if (code.includes('audiovisual') || code.includes('produccion_visual')) {
   return svg('<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M8.5 9.5l2.2 2 4.8-4"/>');
  }
  if (code.includes('letra') || code.includes('pastor')) {
   return svg('<path d="M6 3h9l3 3v15H6z"/><path d="M14 3v4h4M9 11h6M9 15h6"/>');
  }
  if (code.includes('secuencia') || code.includes('director')) {
   return svg('<path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M7 14v6"/>');
  }
  return svg('<path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/>');
 };

const WIZARD_SEPARATE_ROLE_CODES = new Set([
 'audiovisuales',
 'encargado_letras',
 'gestor_secuencias',
 'lider_alabanza',
 'lider_vocal',
 'pastor',
 'voz_principal',
 'voz_soprano',
 'voz_tenor',
]);

 const getStableSession = async () => {
  for (let attempt = 0; attempt < 4; attempt++) {
   const { data: { session }, error } = await supabase.auth.getSession();
   if (session) return { session, error: null };
   if (error && attempt === 3) return { session: null, error };
   await wait(140);
  }
  return { session: null, error: null };
 };

 const initEquipoPage = async () => {
  if (window.location.pathname !== '/equipo') return;
  const pageRoot = document.getElementById('equipo-page-root');
  if (!pageRoot) return;
  if (pageRoot.dataset.equipoInitialized === 'true') return;
  pageRoot.dataset.equipoInitialized = 'true';
 const loadingState = document.getElementById('loading-state');
 const equipoGrid = document.getElementById('equipo-grid')!;
 const emptyState = document.getElementById('empty-state');

 // 1. VerificaciÃ³n de Seguridad y SesiÃ³n
 const { session, error: sessionError } = await getStableSession();
 
 if (sessionError || !session) {
 /* window.location.replace('/login'); Movido a Middleware */
 loadingState?.classList.add('hidden');
 return;
 }

 const canManageOperations = pageRoot.dataset.canManageOperations === 'true';
 
 // Los administradores gestionan roles/equipos. Los gestores designados solo
 // pueden administrar la disponibilidad entre ministerios.
 const isGlobalAdmin = pageRoot.dataset.isGlobalAdmin === 'true';
 const canManageMinistries = pageRoot.dataset.canManageMinistries === 'true';
 const canEditTeamRoles = isGlobalAdmin || canManageOperations;

 if (!isGlobalAdmin) {
 document.querySelectorAll<HTMLElement>('[data-admin-only]').forEach((element) => {
 element.style.display = 'none';
 });
 }

 // 2. Fetch Data (Roles, Perfiles, Perfil_Roles)
 try {
 // Carga paralela para reducir TTI al abrir /equipo
 const [
 { data: roles, error: rolesErr },
 { data: perfilesData, error: perfilesErr },
 { data: pivot, error: pivotErr },
 { data: equiposMaster, error: equiposErr },
 { data: teamMembers, error: tzErr },
 { data: ministries, error: ministriesErr },
 { data: profileMinistries, error: profileMinistriesErr }
 ] = await Promise.all([
 supabase.from('roles').select('id,nombre,codigo').order('nombre'),
 supabase.rpc('get_team_roster_private'),
 supabase.from('perfil_roles').select('perfil_id,rol_id'),
 isGlobalAdmin
 ? supabase.from('equipos').select('id,nombre,letra,created_at').order('created_at', { ascending: false })
 : Promise.resolve({ data: [] as any[], error: null }),
 isGlobalAdmin
 ? supabase.from('equipo_integrantes').select('equipo_id,perfil_id,rol_maestro')
 : Promise.resolve({ data: [] as any[], error: null }),
 supabase.from('ministerios').select('id,codigo,nombre').eq('activo', true),
 canManageMinistries
 ? supabase.from('perfil_ministerios').select('perfil_id,ministerio_id,es_lider')
 : Promise.resolve({ data: [] as any[], error: null })
 ]);

 if (rolesErr) throw rolesErr;
 if (perfilesErr) throw perfilesErr;
 if (pivotErr) throw pivotErr;
 if (equiposErr) throw equiposErr;
 if (tzErr) throw tzErr;
 if (ministriesErr) throw ministriesErr;
 if (profileMinistriesErr) throw profileMinistriesErr;

 const perfiles:any[] = Array.isArray(perfilesData) ? perfilesData : [];

 const generalMinistry = (ministries || []).find((ministry:any) => ministry.codigo === 'alabanza_general') || null;
 const sinFiltrosMinistry = (ministries || []).find((ministry:any) => ministry.codigo === 'sin_filtros') || null;
 const membershipsByProfileAndMinistry = new Map(
 (profileMinistries || []).map((membership:any) => [
 `${membership.perfil_id}:${membership.ministerio_id}`,
 membership
 ])
 );
 const getMembership = (perfilId:string, ministryId?:string) => (
 ministryId ? membershipsByProfileAndMinistry.get(`${perfilId}:${ministryId}`) : null
 );

 window.appStateRoles = roles || []; // Exponer a global para Picker
 window.appStateTeamMembers = teamMembers || [];

 if (!perfiles || perfiles.length === 0) {
 loadingState?.classList.add('hidden');
 emptyState?.classList.remove('hidden');
 return;
 }

 // Renderizar Plantillas
 const secPlantillas = document.getElementById('seccion-plantillas');
 const plantillasGrid = document.getElementById('plantillas-grid')!;
 const headCounter = document.getElementById('equipos-counter-top');
 const btnBuilderBig = document.getElementById('btn-open-team-builder') as HTMLButtonElement;
 const btnBuilderFab = document.getElementById('fab-team-builder')!;
 const scrollHint = document.getElementById('scroll-hint-right')!;
 const checkScroll = () => {
 if (window.innerWidth >= 768 &&
 plantillasGrid.scrollWidth > plantillasGrid.clientWidth &&
 plantillasGrid.scrollLeft < plantillasGrid.scrollWidth - plantillasGrid.clientWidth - 10) {
 scrollHint.classList.remove('opacity-0');
 } else {
 scrollHint.classList.add('opacity-0');
 }
 };

 window.renderPlantillasGlobally = () => {
 const currentCount = equiposMaster ? equiposMaster.length : 0;
 
 if(headCounter) {
 headCounter.textContent = `${currentCount}/10 Equipos`;
 headCounter.classList.remove('hidden');
 }
 
 // Enforcement Limit
 if(currentCount >= 10) {
 btnBuilderBig.disabled = true;
            btnBuilderBig.title = "Límite Máximo de Equipos alcanzado";
 btnBuilderFab.classList.add('hidden');
 } else {
 btnBuilderBig.disabled = false;
 btnBuilderBig.title = "";
 btnBuilderFab.classList.remove('hidden');
 }

 if(currentCount === 0) {
 secPlantillas?.classList.add('hidden');
 return;
 }
 
 secPlantillas?.classList.remove('hidden');
 plantillasGrid.innerHTML = '';
 equiposMaster.forEach(eq => {
 // UX Color Map por Letra
 const colorMap: Record<string, string> = {
 A:'bg-red-500', B:'bg-blue-500', C:'bg-emerald-500', D:'bg-purple-500', E:'bg-amber-500',
 F:'bg-brand', G:'bg-rose-500', H:'bg-indigo-500', I:'bg-orange-500', J:'bg-cyan-500'
 };
 const baseColor = colorMap[eq.letra || 'A'] || 'bg-background';

 // Mostrar las personas que participan musicalmente en la plantilla.
 const myTeam = window.appStateTeamMembers.filter((m:any) => m.equipo_id === eq.id);
 const nonMusicalRoleCodes = new Set([
 'encargado_letras',
 'letra_y_notas',
 'produccion_visual',
 'letras',
 'audiovisuales',
 'pastor',
 'gestor_secuencias'
 ]);
 const peopleById = new Map<string, { perfil: any; roles: any[] }>();

 myTeam.forEach((member:any) => {
 const role = window.appStateRoles.find((rol:any) => rol.id === member.rol_maestro);
 const perfilItem = perfiles.find((perfilRow:any) => perfilRow.id === member.perfil_id);
 if (!role || !perfilItem || nonMusicalRoleCodes.has(String(role.codigo || '').toLowerCase())) return;

 const current = peopleById.get(perfilItem.id) || { perfil: perfilItem, roles: [] };
 if (!current.roles.some((assignedRole:any) => assignedRole.id === role.id)) current.roles.push(role);
 peopleById.set(perfilItem.id, current);
 });

 const getRolePriority = (person:{ roles: any[] }) => {
 if (person.roles.some((role:any) => isEventRepertoryManagerRoleCode(role.codigo) || role.codigo === 'lider_vocal')) return 0;
 if (person.roles.some((role:any) => String(role.codigo || '').startsWith('voz_'))) return 1;
 return 2;
 };
 const musicalPeople = Array.from(peopleById.values()).sort((a, b) => {
 const priorityDiff = getRolePriority(a) - getRolePriority(b);
 return priorityDiff || String(a.perfil.nombre || '').localeCompare(String(b.perfil.nombre || ''), 'es');
 });
 const visiblePeople = musicalPeople.slice(0, 6);
 const remainingPeople = Math.max(0, musicalPeople.length - visiblePeople.length);

 const peopleMarkup = visiblePeople.map(({ perfil: teamPerfil, roles: teamRoles }) => {
 const cleanName = String(teamPerfil.nombre || '').replace(/\s*\(.*?\)\s*/g, '').trim();
 const firstName = cleanName.split(/\s+/)[0] || 'Persona';
 const initials = cleanName.split(/\s+/).filter(Boolean).slice(0, 2).map((part:string) => part[0]).join('').toUpperCase() || 'RD';
 const primaryRole = teamRoles[0];
 const roleCode = String(primaryRole?.codigo || '').toLowerCase();
 const roleTone = isEventRepertoryManagerRoleCode(roleCode) || roleCode === 'lider_vocal'
 ? 'bg-violet-500 text-white'
 : roleCode.startsWith('voz_')
 ? 'bg-rol-voc text-white'
 : 'bg-rol-ban text-white';
 const roleLabel = teamRoles.map((role:any) => role.nombre).filter(Boolean).join(' / ') || 'Músico';
 const safeFullName = escapeHtml(teamPerfil.nombre);
 const safeFirstName = escapeHtml(firstName);
 const safeInitials = escapeHtml(initials);
 const safeRoleLabel = escapeHtml(roleLabel);
 const avatar = teamPerfil.avatar_url
 ? `<img src="${escapeHtml(teamPerfil.avatar_url)}" alt="${safeFullName}" crossorigin="anonymous" loading="lazy" decoding="async" class="h-11 w-11 rounded-full border border-border object-cover shadow-sm">`
 : `<span class="h-11 w-11 rounded-full ${roleTone} flex items-center justify-center text-xs font-black shadow-sm">${safeInitials}</span>`;

 return `
 <div class="min-w-0 flex flex-col items-center text-center">
 <div class="relative">
 ${avatar}
 <span class="absolute -bottom-1 -right-1 h-4 w-4 rounded-full border-2 border-surface ${roleTone} flex items-center justify-center" aria-hidden="true">
 <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/></svg>
 </span>
 </div>
 <p class="mt-2 w-full truncate text-xs font-bold text-content" title="${safeFullName}">${safeFirstName}</p>
 <p class="mt-0.5 w-full truncate text-[9px] font-bold uppercase tracking-wide text-content-muted" title="${safeRoleLabel}">${safeRoleLabel}</p>
 </div>`;
 }).join('');

 const card = document.createElement('article');
 card.className = 'team-card-dashboard relative flex w-full min-w-0 shrink-0 snap-start flex-col rounded-2xl border border-border bg-surface p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md md:w-[340px] md:min-w-[340px]';
 card.setAttribute('data-equipo-id', eq.id);
 const safeTeamName = escapeHtml(eq.nombre);
 const safeTeamLetter = escapeHtml(eq.letra || 'T');
 const safeTeamId = escapeHtml(eq.id);
 card.innerHTML = safeHtml`
 <button type="button" class="team-card-open absolute inset-0 z-0 cursor-pointer rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-action focus-visible:ring-offset-2" data-equipo-id="${safeTeamId}" aria-label="Ver integrantes del equipo ${safeTeamName}"></button>
 <div class="pointer-events-none relative z-10 flex items-center gap-3">
 <div class="w-10 h-10 rounded-full ${baseColor} text-white flex items-center justify-center shrink-0 font-bold font-mono text-lg shadow-sm">
 ${safeTeamLetter}
 </div>
 <div class="flex-1 min-w-0 pr-6">
 <h3 class="font-bold text-content text-base truncate leading-tight">${safeTeamName}</h3>
 <p class="text-[10px] text-content-muted uppercase tracking-wider mt-0.5">${musicalPeople.length} integrante${musicalPeople.length === 1 ? '' : 's'}</p>
 </div>
 </div>
 <div class="pointer-events-none relative z-10 mt-4 rounded-xl border border-border/80 bg-background/70 p-3">
 ${musicalPeople.length > 0
 ? `<div class="grid grid-cols-3 gap-x-3 gap-y-4">${peopleMarkup}</div>
 ${remainingPeople > 0 ? `<p class="mt-3 text-center text-[10px] font-bold text-content-muted">+${remainingPeople} integrante${remainingPeople === 1 ? '' : 's'} más</p>` : ''}`
 : `<div class="flex min-h-20 items-center justify-center text-center"><p class="text-xs font-medium text-content-muted">Sin músicos ni voces asignados</p></div>`}
 </div>
 <button type="button" class="btn-del-plantilla absolute right-1.5 top-1.5 z-20 flex h-11 w-11 items-center justify-center rounded-xl text-content-muted opacity-90 transition-colors hover:bg-red-50 hover:text-red-500 dark:bg-red-900/40" data-id="${safeTeamId}" data-letra="${safeTeamLetter}" data-nombre="${safeTeamName}" title="Eliminar Equipo" aria-label="Eliminar equipo ${safeTeamName}">
 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
 </button>
 `;
 
 plantillasGrid.appendChild(card);
 });
 checkScroll(); // trigger immediately
 };
 plantillasGrid.addEventListener('scroll', checkScroll, { passive: true });
 const plantillasResizeController = new AbortController();
 window.addEventListener('resize', checkScroll, {
  passive: true,
  signal: plantillasResizeController.signal,
 });
 document.addEventListener('astro:before-swap', () => {
  plantillasResizeController.abort();
 }, { once: true, signal: plantillasResizeController.signal });
 window.renderPlantillasGlobally();

 // DelegaciÃ³n de Eventos para botones Delete y Click en Tarjeta
 plantillasGrid.addEventListener('click', async (e) => {
 const targetBtn = (e.target as Element).closest('.btn-del-plantilla') as HTMLButtonElement;
 if (targetBtn) {
 e.stopPropagation();
 e.preventDefault();
 // log
 
 const idEq = targetBtn.getAttribute('data-id');
 const letEq = targetBtn.getAttribute('data-letra');
 const nomEq = targetBtn.getAttribute('data-nombre');
 // log

 // === Abrir Modal de Confirm Personalizado ===
 const modalConfirm = document.getElementById('modal-confirm-delete');
 const msgEl = document.getElementById('confirm-delete-msg');
 const btnOk = document.getElementById('confirm-delete-ok');
 const btnCancel = document.getElementById('confirm-delete-cancel');
 
 if (!modalConfirm) {
 console.error('Modal confirm no encontrado en el DOM!');
 return;
 }
 
 if (msgEl) msgEl.textContent = `Â¿Eliminar "${letEq} - ${nomEq}"?`;
 modalConfirm.setAttribute('aria-hidden', 'false');
 modalConfirm.style.display = 'flex'; // Usar style directo, no classList (evita conflicto flex/hidden)
 
 // Limpiar listeners previos para evitar duplicados
 const newBtnOk = btnOk!.cloneNode(true) as HTMLButtonElement;
 const newBtnCancel = btnCancel!.cloneNode(true) as HTMLButtonElement;
 btnOk!.parentNode!.replaceChild(newBtnOk, btnOk!);
 btnCancel!.parentNode!.replaceChild(newBtnCancel, btnCancel!);
 
 // Evento Cancelar
 newBtnCancel.addEventListener('click', () => {
 modalConfirm.style.display = 'none';
 modalConfirm.setAttribute('aria-hidden', 'true');
 });

 // Evento Confirmar Borrado
 newBtnOk.addEventListener('click', async () => {
 // Cerrar modal inmediatamente (style.display v/s classList para evitar conflicto flex/hidden)
 modalConfirm.style.display = 'none';
 modalConfirm.setAttribute('aria-hidden', 'true');
 // log
 
 newBtnOk.disabled = true;
 targetBtn.disabled = true;
 targetBtn.innerHTML = `<svg class="animate-spin h-4 w-4 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
 
 try {
 const { error } = await supabase.from('equipos').delete().eq('id', idEq);
 if (error) throw error;
 
 // log
 
 // Remover del array maestro in-memory
 const idx = equiposMaster.findIndex((x:any) => x.id === idEq);
 if (idx !== -1) equiposMaster.splice(idx, 1);
 
 // Re-renderizar todo el grid (garantiza consistencia visual)
 window.renderPlantillasGlobally();
 
 // Mostrar Toast de Ã©xito
 const toast = document.createElement('div');
 toast.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 z-[300] bg-neutral-900 text-white text-sm font-semibold px-5 py-3 rounded-full shadow-2xl flex items-center gap-2 animate-bounce';
 toast.innerHTML = safeHtml`<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg> Equipo "${nomEq}" eliminado`;
 document.body.appendChild(toast);
 setTimeout(() => toast.remove(), 3000);
 
 } catch (err:any) {
 console.error('âŒ ERROR SUPABASE DELETE:', err);
 alert('Error al borrar de Supabase: ' + (err.message || JSON.stringify(err)));
 targetBtn.disabled = false;
 targetBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" class="pointer-events-none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>`;
 }
 });

 return;
 }

 // Click en la Tarjeta para Detalles
 const targetCard = (e.target as Element).closest('.team-card-dashboard');
 if (targetCard) {
 const equipoId = targetCard.getAttribute('data-equipo-id');
 if (equipoId && typeof window.openModalEquipoDetalles === 'function') {
 window.openModalEquipoDetalles(equipoId);
 }
 }
 });

 // LÃ³gica del Visor de Detalles de Equipo
 const modalDetalles = document.getElementById('modal-detalles-equipo');
 const panelDetalles = document.getElementById('panel-detalles-equipo');
