---
import Layout from '../layouts/Layout.astro';
import { VOCAL_RANGE_OPTIONS } from '../lib/ministry-config.js';

const canManageOperations = Boolean(Astro.locals.canManageOperations);
const canManageMinistries = Boolean(Astro.locals.canManageMinistries);
const isGlobalAdmin = Boolean(Astro.locals.perfil?.is_admin);

if (!isGlobalAdmin && !canManageMinistries && !canManageOperations) {
 return Astro.redirect('/programacion');
}
---

<Layout title="Gestion de Equipo - Redil">
 <h1 class="sr-only">Gesti&oacute;n de equipo</h1>
 <header class="w-full flex items-center justify-between gap-3 py-2 md:py-4 px-4 md:px-8 mb-2 border-b border-border">
 <div class="flex min-w-0 items-center gap-3">
 <a href="/programacion" aria-label="Volver a programaci&oacute;n" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-surface text-content-muted hover:text-content hover:bg-background dark:text-white transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
 <path d="m15 18-6-6 6-6"/>
 </svg>
 </a>
 <span id="equipos-counter-top" class="hidden text-xs font-bold text-content-muted bg-background px-2 py-1 rounded-full">0/10 Equipos</span>
 </div>
 <div class="flex items-center gap-3">
 <button id="btn-open-team-builder" data-admin-only class="hidden md:flex items-center gap-2 bg-neutral-900 text-white px-4 py-2.5 rounded-xl font-bold hover:bg-neutral-800 dark:bg-background transition-colors shadow-sm text-sm disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-neutral-900 dark:disabled:bg-surface">
 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" class="opacity-80" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
 Crear Equipo
 </button>
 </div>
 </header>
 
 <!-- BotÃ³n Flotante Mobile para Plantillas -->
 <button id="fab-team-builder" data-admin-only class="md:hidden fixed bottom-6 right-6 w-14 h-14 bg-gradient-to-r from-neutral-900 to-neutral-800 text-white rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all z-40">
 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
 </button>

 <!-- Botón Flotante para Añadir Músico -->
 <button id="fab-add-musico" data-admin-only class="fixed bottom-32 right-4 md:bottom-32 md:right-8 bg-action hover:bg-action/80 text-white w-14 h-14 md:w-auto md:px-6 rounded-full shadow-2xl flex items-center justify-center gap-2 transition-transform hover:scale-105 z-40 group">
 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-90 transition-transform duration-300"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
 <span class="hidden md:block font-bold text-base">A&#241;adir M&#250;sico</span>
 </button>

 <main id="equipo-page-root" data-can-manage-operations={canManageOperations ? 'true' : 'false'} data-can-manage-ministries={canManageMinistries ? 'true' : 'false'} data-is-global-admin={isGlobalAdmin ? 'true' : 'false'} class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-32">
 <!-- SECCIÃ“N MIS EQUIPOS -->
 <div class="mb-8 hidden" id="seccion-plantillas">
 <div class="flex items-center justify-between mb-4">
 <h2 class="text-xs font-bold text-content-muted uppercase tracking-widest flex items-center gap-2">
 <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-action" stroke="currentColor" stroke-width="2.5"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
 Mis Equipos
 </h2>
 </div>
 <div class="relative w-full">
 <!-- Pista visual scroll derecho -->
 <div class="absolute right-0 top-0 bottom-0 w-12 bg-gradient-to-l from-neutral-50 [#0a0a0a] to-transparent pointer-events-none z-10 hidden md:block" id="scroll-hint-right"></div>
 
 <div id="plantillas-grid" class="custom-scrollbar relative z-0 flex w-full flex-col gap-4 pb-4 md:flex-row md:overflow-x-auto md:snap-x">
 <!-- Se inyectan cards -->
 </div>
 </div>
 </div>

 <div id="loading-state" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-pulse mt-4">
 <!-- Skeleton Cards -->
 {Array(6).fill('').map(() => (
 <div class="bg-surface border border-border rounded-2xl p-6 shadow-sm">
 <div class="flex items-center gap-4 mb-4">
 <div class="w-12 h-12 bg-neutral/20 rounded-full"></div>
 <div class="space-y-2 flex-1">
 <div class="h-4 bg-neutral/20 rounded w-3/4"></div>
 <div class="h-3 bg-neutral/20 rounded w-1/2"></div>
 </div>
 </div>
 <div class="h-10 bg-neutral/20 rounded w-full mb-2"></div>
 <div class="h-10 bg-neutral/20 rounded w-full"></div>
 </div>
 ))}
 </div>

 <div id="equipo-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 hidden">
 <!-- Los perfiles se inyectarÃ¡n aquÃ­ -->
 </div>

 <div id="empty-state" class="hidden flex flex-col items-center justify-center py-20 text-center">
 <div class="w-20 h-20 bg-background rounded-full flex items-center justify-center mb-6">
 <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-content-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
 <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
 <circle cx="9" cy="7" r="4"/>
 <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
 <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
 </svg>
 </div>
 <h3 class="text-xl font-bold text-content mb-2">No hay mÃºsicos registrados</h3>
 <p class="text-content-muted max-w-md">Ejecuta el script SQL de inicializaciÃ³n en Supabase para registrar a los mÃºsicos y sus roles.</p>
 </div>
 
 <!-- Observer Sentinel -->
 <div id="scroll-sentinel" class="w-full h-10 mt-8 flex justify-center items-center opacity-0 transition-opacity">
 <svg class="animate-spin h-6 w-6 text-content-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
 <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
 </svg>
 </div>

 <!-- WIZARD GLOBAL DE GESTIÓN DE PERFIL -->
 <div id="modal-roles-global" class="team-wizard-modal fixed inset-0 z-[100] hidden items-center justify-center" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="modal-roles-title" data-ui-modal="true" data-ui-bottom-sheet="true">
 <div class="team-wizard-backdrop" id="modal-roles-backdrop"></div>

 <div class="team-wizard-panel" id="modal-roles-panel" data-ui-bottom-sheet-panel="true">
 <header class="team-wizard-hero">
 <div class="team-wizard-hero-media" aria-hidden="true">
 <img id="modal-profile-image" alt="" crossorigin="anonymous" class="hidden">
 <div id="modal-profile-initials" class="team-wizard-profile-initials">RD</div>
 </div>
 <div class="team-wizard-hero-scrim" aria-hidden="true"></div>
 <button type="button" id="btn-close-modal-roles" class="team-wizard-close" aria-label="Cerrar gestión de perfil">
 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
 </button>
 <div class="team-wizard-identity">
 <p class="team-wizard-eyebrow">Gestionar integrante</p>
 <h3 id="modal-roles-title">Perfil del músico</h3>
 <p id="modal-profile-email"></p>
 </div>
 </header>

 <nav class="team-wizard-nav" aria-label="Secciones de gestión" role="tablist">
 <button type="button" class="team-wizard-nav-item" data-wizard-step="0" role="tab" aria-selected="true" aria-controls="wizard-step-ministries">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg>
 <span>Ministerio</span>
 </button>
 <button type="button" class="team-wizard-nav-item" data-wizard-step="1" role="tab" aria-selected="false" aria-controls="wizard-step-leadership">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="m12 3 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7z"/></svg>
 <span>Liderazgo</span>
 </button>
 <button type="button" class="team-wizard-nav-item" data-wizard-step="2" role="tab" aria-selected="false" aria-controls="wizard-step-roles">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>
 <span>Roles</span>
 </button>
 <button type="button" class="team-wizard-nav-item" data-wizard-step="3" role="tab" aria-selected="false" aria-controls="wizard-step-voice">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>
 <span>Voz</span>
 </button>
 </nav>

 <div class="team-wizard-stage" id="team-wizard-stage">
 <section id="wizard-step-ministries" class="team-wizard-step" data-wizard-panel="0" data-state="active" role="tabpanel">
 <div class="team-wizard-step-heading">
 <p>Paso 1</p>
 <h4>¿Dónde sirve?</h4>
 <span>Selecciona uno o ambos ministerios.</span>
 </div>
 <div id="modal-ministries-section" class="team-wizard-options">
 <label class="team-wizard-option">
 <span class="team-wizard-option-icon team-wizard-option-icon--general">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M4 19h16M6 19V8l6-4 6 4v11M9 12h6M12 9v6"/></svg>
 </span>
 <span class="team-wizard-option-copy">
 <strong>Los domingos</strong>
 <small>Culto de Adoración Dominical</small>
 </span>
 <input id="modal-general-member" type="checkbox" class="team-wizard-toggle-input">
 <span class="team-wizard-toggle" aria-hidden="true"><span></span></span>
 </label>
 <label class="team-wizard-option">
 <span class="team-wizard-option-icon team-wizard-option-icon--youth">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg>
 </span>
 <span class="team-wizard-option-copy">
 <strong>Sin Filtros</strong>
 <small>Servicios de los sábados</small>
 </span>
 <input id="modal-sin-filtros-member" type="checkbox" class="team-wizard-toggle-input">
 <span class="team-wizard-toggle" aria-hidden="true"><span></span></span>
 </label>
 </div>
 </section>

 <section id="wizard-step-leadership" class="team-wizard-step" data-wizard-panel="1" data-state="after" role="tabpanel" aria-hidden="true">
 <div class="team-wizard-step-heading">
 <p>Paso 2</p>
 <h4>Permitir liderazgo</h4>
 <span>El liderazgo se configura por ministerio.</span>
 </div>
 <div class="team-wizard-options">
 <label class="team-wizard-option team-wizard-leadership-option">
 <span class="team-wizard-option-icon team-wizard-option-icon--general">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="m12 3 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7z"/></svg>
 </span>
 <span class="team-wizard-option-copy">
 <strong>Liderar los domingos</strong>
 <small id="modal-general-leader-help">Requiere servir en Culto Dominical</small>
 </span>
 <input id="modal-general-leader" type="checkbox" class="team-wizard-toggle-input" disabled>
 <span class="team-wizard-toggle" aria-hidden="true"><span></span></span>
 </label>
 <label class="team-wizard-option team-wizard-leadership-option">
 <span class="team-wizard-option-icon team-wizard-option-icon--youth">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="m12 3 2.2 4.5 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7z"/></svg>
 </span>
 <span class="team-wizard-option-copy">
 <strong>Liderar Sin Filtros</strong>
 <small id="modal-sin-filtros-leader-help">Requiere servir en Sin Filtros</small>
 </span>
 <input id="modal-sin-filtros-leader" type="checkbox" class="team-wizard-toggle-input" disabled>
 <span class="team-wizard-toggle" aria-hidden="true"><span></span></span>
 </label>
 </div>
 </section>

 <section id="wizard-step-roles" class="team-wizard-step" data-wizard-panel="2" data-state="after" role="tabpanel" aria-hidden="true">
 <div class="team-wizard-step-heading">
 <p>Paso 3</p>
 <h4>Roles musicales</h4>
 <span>Puedes elegir varios instrumentos o capacidades.</span>
 </div>
 <div class="team-wizard-role-grid" id="modal-roles-container">
 <!-- Inyección dinámica de roles musicales -->
 </div>
 </section>

 <section id="wizard-step-voice" class="team-wizard-step" data-wizard-panel="3" data-state="after" role="tabpanel" aria-hidden="true">
 <div class="team-wizard-step-heading">
 <p>Paso 4</p>
 <h4>Configuraci&oacute;n de voz</h4>
 <span>La voz y su registro se administran aparte de los instrumentos.</span>
 </div>
 <label class="team-wizard-option team-wizard-voice-option">
 <span class="team-wizard-option-icon team-wizard-option-icon--voice">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>
 </span>
 <span class="team-wizard-option-copy">
 <strong>Voz</strong>
 <small>Puede ser asignado en el equipo vocal</small>
 </span>
 <input id="modal-voice-enabled" type="checkbox" class="team-wizard-toggle-input">
 <span class="team-wizard-toggle" aria-hidden="true"><span></span></span>
 </label>
 <div id="modal-vocal-range-section" class="team-wizard-vocal-card">
 <span class="team-wizard-vocal-icon" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>
 </span>
 <div class="team-wizard-vocal-copy">
 <strong>Registro vocal</strong>
 <small id="modal-vocal-range-help">Activa Voz para definir la clasificaci&oacute;n.</small>
 </div>
 <label class="team-wizard-vocal-field" for="modal-vocal-range">
 <span class="sr-only">Registro vocal</span>
 <select id="modal-vocal-range" disabled>
 <option value="">Por definir</option>
 {VOCAL_RANGE_OPTIONS.map((option) => (
 <option value={option.value}>{option.label}</option>
 ))}
 </select>
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
 </label>
 </div>
 </section>
 </div>

 <footer class="team-wizard-footer">
 <div class="team-wizard-progress">
 <span id="team-wizard-progress-label">Paso 1 de 4</span>
 <div><i id="team-wizard-progress-bar"></i></div>
 </div>
 <div class="team-wizard-footer-actions">
 <button type="button" id="btn-wizard-back" class="team-wizard-secondary hidden">Atrás</button>
 <button type="button" id="btn-wizard-next" class="team-wizard-primary">
 Siguiente
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
 </button>
 <button type="button" id="btn-roles-submit" class="team-wizard-primary hidden">Guardar cambios</button>
 </div>
 </footer>
 </div>
 </div>

 <!-- MODAL CONSTRUCTOR DE PLANTILLAS (Team Builder) -->
 <div id="modal-team-builder" class="fixed inset-0 z-[80] hidden items-end sm:items-center justify-center" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="team-builder-title" data-ui-modal="true" data-ui-bottom-sheet="true">
 <!-- Backdrop -->
 <div class="absolute inset-0 bg-neutral-900/40 backdrop-blur-sm transition-opacity opacity-0" id="tb-backdrop"></div>
 
 <!-- Panel -->
 <div class="relative bg-surface w-full sm:w-[90vw] md:w-[600px] shrink-0 rounded-t-3xl sm:rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[calc(var(--app-modal-viewport-height,100dvh)-0.5rem)] sm:max-h-[85vh] transition-transform translate-y-full sm:translate-y-4 sm:scale-95 sm:opacity-0" id="tb-panel" data-ui-bottom-sheet-panel="true">
 <!-- Header -->
 <div class="px-5 sm:px-6 py-4 sm:py-5 border-b border-neutral-100 flex justify-between items-center bg-surface/50 backdrop-blur-md sticky top-0 z-10">
 <div>
 <h3 id="team-builder-title" class="text-xl sm:text-2xl font-bold text-content tracking-tight">Constructor de Equipo</h3>
 <p class="text-xs text-content-muted mt-1">Crea moldes de equipo para cargarlos rÃ¡pidamente.</p>
 </div>
 <div class="flex gap-2">
 <button type="button" id="btn-tb-cancelar" class="p-2 sm:px-4 sm:py-2 text-content-muted hover:text-neutral dark:text-neutral-200 hover:bg-background dark:bg-neutral-800 rounded-xl transition-colors font-bold text-sm hidden sm:block">Cancelar</button>
 <button type="button" id="btn-tb-close" class="p-2 -mr-2 text-content-muted hover:text-neutral-700 dark:text-neutral-200 hover:bg-background dark:bg-neutral-800 rounded-full transition-colors sm:hidden">
 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
 </button>
 </div>
 </div>
 
 <!-- Body Formulario -->
 <form id="form-team-builder" class="min-h-0 flex flex-1 flex-col overflow-hidden">
 <div class="custom-scrollbar min-h-0 flex-1 overflow-y-auto overscroll-contain p-5 sm:p-6 space-y-6">
 <!-- Letra y Nombre de Equipo -->
 <div class="flex flex-col sm:flex-row gap-4">
 <div class="w-full sm:w-28 space-y-2 shrink-0">
 <label for="tb-letra" class="block text-xs uppercase tracking-wider font-bold text-content-muted ">Letra</label>
 <div class="relative">
 <select id="tb-letra" required class="appearance-none w-full bg-background border border-border text-content text-lg rounded-xl focus:ring-2 focus:ring-action focus:border-transparent outline-none transition-all px-4 py-3 cursor-pointer font-bold font-mono text-center">
 <option value="A" selected>A</option>
 <option value="B">B</option>
 <option value="C">C</option>
 <option value="D">D</option>
 <option value="E">E</option>
 <option value="F">F</option>
 <option value="G">G</option>
 <option value="H">H</option>
 <option value="I">I</option>
 <option value="J">J</option>
 </select>
 <svg class="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
 </div>
 </div>
 <div class="space-y-2 flex-1 min-w-0">
 <label for="tb-nombre" class="block text-xs uppercase tracking-wider font-bold text-content-muted ">Nombre del Equipo</label>
 <input type="text" id="tb-nombre" required class="w-full bg-background border border-border text-content text-lg rounded-xl focus:ring-2 focus:ring-action focus:border-transparent outline-none transition-all px-4 py-3 placeholder:text-content-muted" placeholder="Ej: Banda Dominical" autocomplete="off">
 </div>
 </div>

 <hr class="border-neutral-100 ">

 <!-- Grilla Similar a Programacion.astro -->
 <div class="space-y-4">
 <h4 class="text-sm font-bold text-content flex justify-between items-center">
 DefiniciÃ³n de Integrantes
 <span class="text-xs font-normal text-content-muted bg-background px-2 py-0.5 rounded-full" id="tb-counter-label">0 Asignados</span>
 </h4>
 
 <div class="bg-background rounded-2xl p-4 sm:p-5 border border-neutral-100 ">
 <!-- L1 L2 -->
 <div class="grid grid-cols-2 gap-4 mb-5">
 <div class="flex flex-col">
            <div class="flex items-center justify-between mb-3"><span class="text-[10px] font-bold text-violet-600 uppercase tracking-widest">Dirección</span><div class="h-px flex-1 bg-violet-200 ml-2"></div></div>
 <div class="grid grid-cols-1 gap-2" id="tb-n1-slots"></div>
 </div>
 <div class="flex flex-col">
 <div class="flex items-center justify-between mb-3 w-full"><span class="text-[10px] font-bold text-amber-600 uppercase tracking-widest">Letras</span><div class="h-px flex-1 bg-amber-200 ml-2"></div></div>
 <div class="grid grid-cols-1 gap-2" id="tb-n2-slots"></div>
 </div>
 </div>
