<style is:global>
 .equipo-card {
  position: relative;
  min-height: 340px;
  overflow: hidden;
  isolation: isolate;
  border: 1px solid rgb(var(--border-base));
  border-radius: 1.75rem;
  background: rgb(var(--bg-surface));
  box-shadow: 0 10px 30px -22px rgb(15 23 42 / 0.42);
  transition:
   opacity 0.5s ease,
   transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
   border-color 0.3s ease,
   box-shadow 0.3s ease;
 }

 .equipo-card:focus-visible {
  outline: 3px solid rgb(var(--color-brand) / 0.42);
  outline-offset: 3px;
 }

 .equipo-card-media {
  position: absolute;
  z-index: 0;
  top: 12px;
  right: 12px;
  left: 12px;
  height: 150px;
  overflow: hidden;
  border: 1px solid rgb(var(--border-base) / 0.82);
  border-radius: 1.25rem;
  background:
   radial-gradient(circle at 30% 20%, rgb(var(--color-brand) / 0.22), transparent 52%),
   linear-gradient(145deg, rgb(var(--bg-base)), rgb(var(--border-base) / 0.5));
  transition:
   inset 0.52s cubic-bezier(0.22, 1, 0.36, 1),
   height 0.52s cubic-bezier(0.22, 1, 0.36, 1),
   border-radius 0.52s cubic-bezier(0.22, 1, 0.36, 1),
   transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
 }

 .equipo-card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 28%;
  transform: scale(1.01);
  transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
 }

 .equipo-card-initials {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: rgb(var(--color-brand));
  font-size: 2.25rem;
  font-weight: 900;
  letter-spacing: -0.06em;
 }

 .equipo-card-scrim {
  position: absolute;
  z-index: 1;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  background:
   linear-gradient(180deg, rgb(2 6 23 / 0.02) 12%, rgb(2 6 23 / 0.24) 48%, rgb(2 6 23 / 0.92) 100%);
  transition: opacity 0.38s ease;
 }

 .equipo-card-content {
  position: absolute;
