 const modalMinistriesSection = document.getElementById('modal-ministries-section');
 const modalGeneralMember = document.getElementById('modal-general-member') as HTMLInputElement;
 const modalGeneralLeader = document.getElementById('modal-general-leader') as HTMLInputElement;
 const modalSinFiltrosMember = document.getElementById('modal-sin-filtros-member') as HTMLInputElement;
 const modalSinFiltrosLeader = document.getElementById('modal-sin-filtros-leader') as HTMLInputElement;
 const modalGeneralLeaderHelp = document.getElementById('modal-general-leader-help');
 const modalSinFiltrosLeaderHelp = document.getElementById('modal-sin-filtros-leader-help');
 const btnCloseModalRoles = document.getElementById('btn-close-modal-roles') as HTMLButtonElement;
 const btnWizardBack = document.getElementById('btn-wizard-back') as HTMLButtonElement;
 const btnWizardNext = document.getElementById('btn-wizard-next') as HTMLButtonElement;
 const btnRolesSubmit = document.getElementById('btn-roles-submit') as HTMLButtonElement;
 const wizardProgressLabel = document.getElementById('team-wizard-progress-label');
 const wizardProgressBar = document.getElementById('team-wizard-progress-bar') as HTMLElement;
 const wizardNav = document.querySelector<HTMLElement>('.team-wizard-nav');
 const wizardNavItems = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-wizard-step]'));
 const wizardPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-wizard-panel]'));
 const worshipLeaderRole = roles.find((role:any) => role.codigo === 'lider_alabanza') || null;
 let currentPerfilId: string | null = null;
 let currentWizardStep = 0;
 let wizardTrigger: HTMLButtonElement | null = null;
 let modalRolesCloseTimer: number | null = null;

 const availableWizardSteps = [
  ...(canManageMinistries ? [0, 1] : []),
  ...(canEditTeamRoles ? [2, 3] : []),
 ];

 const setWizardStep = (requestedStep:number, focusTab = false) => {
  const fallbackStep = availableWizardSteps[0] ?? 0;
  const nextStep = availableWizardSteps.includes(requestedStep) ? requestedStep : fallbackStep;
  currentWizardStep = nextStep;

  wizardPanels.forEach((panel) => {
   const panelStep = Number(panel.dataset.wizardPanel);
   const state = panelStep === nextStep ? 'active' : panelStep < nextStep ? 'before' : 'after';
   panel.dataset.state = state;
   panel.setAttribute('aria-hidden', state === 'active' ? 'false' : 'true');
   if (state === 'active') panel.scrollTop = 0;
  });

  wizardNavItems.forEach((item) => {
   const itemStep = Number(item.dataset.wizardStep);
   const isAvailable = availableWizardSteps.includes(itemStep);
   const isActive = itemStep === nextStep;
   item.classList.toggle('hidden', !isAvailable);
   item.setAttribute('aria-selected', isActive ? 'true' : 'false');
   item.tabIndex = isActive ? 0 : -1;
   if (focusTab && isActive) item.focus();
  });

 const stepIndex = Math.max(0, availableWizardSteps.indexOf(nextStep));
 const stepTotal = Math.max(1, availableWizardSteps.length);
  if (wizardNav) wizardNav.style.gridTemplateColumns = `repeat(${stepTotal}, minmax(0, 1fr))`;
  if (wizardProgressLabel) wizardProgressLabel.textContent = `Paso ${stepIndex + 1} de ${stepTotal}`;
  if (wizardProgressBar) wizardProgressBar.style.width = `${((stepIndex + 1) / stepTotal) * 100}%`;
  btnWizardBack.classList.toggle('hidden', stepIndex === 0);
  btnWizardNext.classList.toggle('hidden', stepIndex >= stepTotal - 1);
  btnRolesSubmit.classList.toggle('hidden', stepIndex < stepTotal - 1);
 };

 const syncLeadershipAvailability = () => {
  modalGeneralLeader.disabled = !modalGeneralMember.checked;
  modalSinFiltrosLeader.disabled = !modalSinFiltrosMember.checked;
  if (!modalGeneralMember.checked) modalGeneralLeader.checked = false;
  if (!modalSinFiltrosMember.checked) modalSinFiltrosLeader.checked = false;
  if (modalGeneralLeaderHelp) {
   modalGeneralLeaderHelp.textContent = modalGeneralMember.checked
   ? 'Puede liderar el Culto Dominical'
   : 'Activa primero Los domingos';
  }
  if (modalSinFiltrosLeaderHelp) {
   modalSinFiltrosLeaderHelp.textContent = modalSinFiltrosMember.checked
   ? 'Puede liderar los servicios juveniles'
   : 'Activa primero Sin Filtros';
  }
 };

 const syncVocalRangeAvailability = () => {
  const voiceEnabled = modalVoiceEnabled.checked;
  modalVocalRange.disabled = !voiceEnabled;
  modalVocalRangeSection?.classList.toggle('is-disabled', !voiceEnabled);
  if (modalVocalRangeHelp) {
   modalVocalRangeHelp.textContent = voiceEnabled
    ? 'Clasificación separada del rol musical Voz.'
    : 'Activa Voz para definir la clasificación.';
  }
 };

 const toggleModalRoles = (show: boolean) => {
  if (!modalRoles) return;
  if (modalRolesCloseTimer !== null) {
   window.clearTimeout(modalRolesCloseTimer);
   modalRolesCloseTimer = null;
  }

  if (show) {
   modalRoles.setAttribute('aria-hidden', 'false');
   modalRoles.classList.remove('hidden');
   modalRoles.classList.add('flex');
   document.body.style.overflow = 'hidden';
   void modalRoles.offsetWidth;
   modalRoles.classList.add('is-open');
   window.setTimeout(() => btnCloseModalRoles?.focus(), 180);
   return;
  }

  modalRoles.classList.remove('is-open');
  modalRolesCloseTimer = window.setTimeout(() => {
   modalRoles.classList.add('hidden');
   modalRoles.classList.remove('flex');
   modalRoles.setAttribute('aria-hidden', 'true');
   document.body.style.overflow = '';
   wizardTrigger?.focus();
   modalRolesCloseTimer = null;
  }, 380);
 };

 btnRolesSubmit?.addEventListener('click', async () => {
  if (!currentPerfilId) return;
  btnRolesSubmit.innerHTML = '<span class="flex items-center justify-center gap-2"><span class="h-4 w-4 rounded-full border-2 border-white/25 border-t-white animate-spin"></span> Guardando...</span>';
  btnRolesSubmit.disabled = true;
  btnWizardBack.disabled = true;
  wizardNavItems.forEach((item) => { item.disabled = true; });

  try {
   if (canEditTeamRoles) {
    const roleInputs = Array.from(modalRolesContainer.querySelectorAll<HTMLInputElement>('input[data-rol]'));
    const managedRoleIds = new Set(roleInputs.map((input) => input.dataset.rol).filter(Boolean) as string[]);
    const selectedRoleIds = new Set(
     roleInputs.filter((input) => input.checked).map((input) => input.dataset.rol).filter(Boolean) as string[]
    );

    // El rol maestro de liderazgo deja de mostrarse como instrumento y se
    // deriva de los permisos por ministerio. Gestores ligeros no elevan roles.
    if (isGlobalAdmin && worshipLeaderRole?.id) {
     managedRoleIds.add(worshipLeaderRole.id);
     if (modalGeneralLeader.checked || modalSinFiltrosLeader.checked) {
      selectedRoleIds.add(worshipLeaderRole.id);
     }
    }

    const existingRoleIds = new Set<string>(rolesPorPerfil.get(currentPerfilId) || []);
    const roleIdsToDelete = [...managedRoleIds].filter((roleId) => (
     existingRoleIds.has(roleId) && !selectedRoleIds.has(roleId)
    ));
    const roleIdsToInsert = [...selectedRoleIds].filter((roleId) => !existingRoleIds.has(roleId));

    if (roleIdsToDelete.length > 0) {
     const { error } = await supabase
      .from('perfil_roles')
      .delete()
      .eq('perfil_id', currentPerfilId)
      .in('rol_id', roleIdsToDelete);
     if (error) throw error;
    }

    if (roleIdsToInsert.length > 0) {
     const { error } = await supabase
      .from('perfil_roles')
      .insert(roleIdsToInsert.map((roleId) => ({ perfil_id: currentPerfilId, rol_id: roleId })));
     if (error) throw error;
    }

    const voiceEnabled = modalVoiceEnabled.checked;
    const vocalRangeResponse = await fetch('/api/team-vocal-range', {
     method: 'POST',
     credentials: 'same-origin',
     headers: { 'content-type': 'application/json' },
     body: JSON.stringify({
      profileId: currentPerfilId,
      voiceEnabled,
      vocalRange: voiceEnabled ? modalVocalRange.value : null,
     }),
    });
    if (!vocalRangeResponse.ok) {
     const vocalRangeError = await vocalRangeResponse.json().catch(() => ({}));
     throw new Error(vocalRangeError?.error || 'No se pudo guardar el registro vocal.');
    }
   }

   if (canManageMinistries) {
    const syncMembership = async (
     ministry:any,
     memberInput:HTMLInputElement,
     leaderInput:HTMLInputElement
    ) => {
     if (!ministry) throw new Error('No se encontró uno de los ministerios configurados.');

     if (memberInput.checked) {
      const { error } = await supabase
       .from('perfil_ministerios')
       .upsert({
        perfil_id: currentPerfilId,
        ministerio_id: ministry.id,
        es_lider: leaderInput.checked
       }, { onConflict: 'perfil_id,ministerio_id' });
      if (error) throw error;
      return;
     }

     const { error } = await supabase
      .from('perfil_ministerios')
      .delete()
      .eq('perfil_id', currentPerfilId)
      .eq('ministerio_id', ministry.id);
     if (error) throw error;
    };

    await syncMembership(generalMinistry, modalGeneralMember, modalGeneralLeader);
    await syncMembership(sinFiltrosMinistry, modalSinFiltrosMember, modalSinFiltrosLeader);
   }

   window.location.reload();
  } catch(err) {
   console.error('Error al guardar la configuración del perfil:', err);
   alert('No pudimos guardar los cambios. Intenta nuevamente.');
   btnRolesSubmit.textContent = 'Guardar cambios';
   btnRolesSubmit.disabled = false;
   btnWizardBack.disabled = false;
   wizardNavItems.forEach((item) => { item.disabled = false; });
  }
 });

 btnCloseModalRoles?.addEventListener('click', () => toggleModalRoles(false));
