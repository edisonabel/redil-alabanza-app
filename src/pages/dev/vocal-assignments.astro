---
import '../../styles/global.css';
import VoiceAssignmentPreview from '../../components/react/dev/VoiceAssignmentPreview.jsx';

if (!import.meta.env.DEV) {
  return new Response('Not found', { status: 404 });
}

const previewIsDark = Astro.url.searchParams.get('theme') === 'dark';
const initialVoiceCount = Math.max(4, Math.min(6, Number(Astro.url.searchParams.get('eventVoices')) || 4));
---

<!doctype html>
<html lang="es" class:list={{ dark: previewIsDark }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Vista local · Asignaciones vocales</title>
  </head>
  <body class="min-h-screen overflow-hidden bg-slate-50 dark:bg-zinc-950">
    <VoiceAssignmentPreview client:only="react" initialVoiceCount={initialVoiceCount} />
  </body>
</html>
