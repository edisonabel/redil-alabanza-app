---
import Layout from '../layouts/Layout.astro';
---
<Layout>
 <h1 class="sr-only">Herramientas</h1>

 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4 md:mt-8 max-w-5xl mx-auto px-4 pb-12">
 <!-- Metr&oacute;nomo PRO -->
 <a href="/herramientas/metronomo" class="bg-surface border border-border rounded-2xl p-6 hover:bg-background hover:-translate-y-1 transition-all duration-300 shadow-xl group card-herramienta">
 <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 mb-3 text-brand"><path d="m15 11 5-5"/><path d="m11 15 5-5"/><path d="M22 12A10 10 0 1 1 12 2a10 10 0 0 1 10 10Z"/><path d="M12 22v-3"/><path d="M12 5V2"/><path d="M22 12h-3"/><path d="M5 12H2"/></svg>
 <h3 class="text-xl font-bold text-content mb-2 group-hover:text-brand transition-colors">Metr&oacute;nomo PRO</h3>
 <p class="text-content-muted text-sm leading-relaxed">Motor de alta precisi&oacute;n con Rueda interactiva (iPod style), Tap Tempo y m&eacute;tricas variables.</p>
 </a>

 <!-- Calentamiento Vocal -->
 <a href="/herramientas/calentamiento-vocal" class="bg-surface border border-border rounded-2xl p-6 hover:bg-background hover:-translate-y-1 transition-all duration-300 shadow-xl group card-herramienta">
 <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 mb-3 text-brand"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
 <h3 class="text-xl font-bold text-content mb-2 group-hover:text-brand transition-colors">Calentamiento Vocal</h3>
 <p class="text-content-muted text-sm leading-relaxed">Recurso r&aacute;pido para precalentamiento vocal antes del ensayo o del servicio.</p>
 </a>

 <!-- Capotraste -->
 <a href="/herramientas/capo" class="bg-surface border border-border rounded-2xl p-6 hover:bg-background hover:-translate-y-1 transition-all duration-300 shadow-xl group card-herramienta">
 <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 mb-3 text-info"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><circle cx="8" cy="9" r="2"/><circle cx="16" cy="15" r="2"/></svg>
 <h3 class="text-xl font-bold text-content mb-2 group-hover:text-info transition-colors">Capotraste</h3>
 <p class="text-content-muted text-sm leading-relaxed">Encuentra las posiciones de acordes ideales para guitarra ac&uacute;stica seg&uacute;n el tono original.</p>
 </a>

 <!-- Afinador inteligente -->
 <a href="/herramientas/afinador" class="bg-surface border border-border rounded-2xl p-6 hover:bg-background hover:-translate-y-1 transition-all duration-300 shadow-xl group card-herramienta">
 <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 mb-3 text-emerald-500"><path d="M12 3v18"/><path d="M5 8v8"/><path d="M19 6v12"/><path d="M8.5 5.5v13"/><path d="M15.5 5.5v13"/></svg>
 <h3 class="text-xl font-bold text-content mb-2 group-hover:text-emerald-500 transition-colors">Afinador Inteligente</h3>
 <p class="text-content-muted text-sm leading-relaxed">Afina guitarra o voz y valida en verde o rojo si la nota pertenece a la escala seleccionada.</p>
 </a>

 <!-- Conversor de Stems -->
 <a href="/herramientas/conversor-stems" class="bg-surface border border-border rounded-2xl p-6 hover:bg-background hover:-translate-y-1 transition-all duration-300 shadow-xl group card-herramienta">
 <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 mb-3 text-brand"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/><path d="M8 3h8"/></svg>
 <h3 class="text-xl font-bold text-content mb-2 group-hover:text-brand transition-colors">Conversor de Stems</h3>
 <p class="text-content-muted text-sm leading-relaxed">Convierte WAV/FLAC/AIFF/CAF a M4A/AAC en el navegador, con limite seguro de 15 stems.</p>
 </a>

 </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const { data: { session }, error: sessionError } = await supabase.auth.getSession();
    
    if (sessionError || !session) {
      /* window.location.replace('/login'); Movido a Middleware */
      return;
    }
  });
</script>
