---
// One song in rehearsal mode, outside an event (Repertorio and any other page).
// It lives under /ensayo/* so it gets cross-origin isolation, which the
// multitrack engine needs to play the full sequence in sync.
import '../../../styles/global.css';
import EnsayoGlobalIsland from '../../../components/react/EnsayoGlobalIsland.jsx';
import AuthSessionBridge from '../../../components/AuthSessionBridge.astro';
import { getBrandingConfig } from '../../../lib/branding';
import { createSupabaseUserClient } from '../../../lib/server/supabase-user-client.js';
import { pickPreferredVoicePayload } from '../../../utils/voicePayload.js';

const user = Astro.locals.user;
const accessToken = Astro.locals.accessToken || Astro.cookies.get('sb-access-token')?.value || '';
if (!user || !accessToken) {
  return Astro.redirect('/login');
}

const songId = String(Astro.params.songId || '').trim();
const supabaseSSR = createSupabaseUserClient(accessToken);
const { data: cancion, error } = songId
  ? await supabaseSSR
    .from('canciones')
    .select('id, titulo, cantante, tonalidad, bpm, chordpro, link_secuencias, link_voces, link_youtube, mp3, multitrack_session, section_markers, voces')
    .eq('id', songId)
    .maybeSingle()
  : { data: null, error: null };

if (error) {
  console.error('[ensayo/cancion] No se pudo cargar la canción:', error);
}
if (!cancion) {
  return Astro.redirect('/repertorio');
}

const initialSong = {
  id: String(cancion.id),
  title: cancion.titulo || '',
  artist: cancion.cantante || '',
  key: cancion.tonalidad || '',
  bpm: Number(cancion.bpm) || 0,
  mp3: cancion.mp3 || '',
  chordpro: cancion.chordpro || '',
  linkVoces: pickPreferredVoicePayload(cancion.link_voces, cancion.voces),
  linkYoutube: cancion.link_youtube || '',
  linkSecuencias: cancion.link_secuencias || '',
  hasRehearsalPlaybackSession: Boolean(cancion.multitrack_session),
  hasMultitrackSession: false,
  ...(cancion.multitrack_session ? { multitrackSession: cancion.multitrack_session } : {}),
  sectionMarkers: Array.isArray(cancion.section_markers) ? cancion.section_markers : [],
};

// Back goes where the musician came from; Repertorio when opened from a link.
const exitHref = '/repertorio';

const hexToRgbString = (hex: unknown) => {
  if (!hex || typeof hex !== 'string') return '';
  const value = hex.trim();
  if (!/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(value)) return value;
  const full = value.length === 4
    ? `#${value[1]}${value[1]}${value[2]}${value[2]}${value[3]}${value[3]}`
    : value;
  return `${parseInt(full.slice(1, 3), 16)} ${parseInt(full.slice(3, 5), 16)} ${parseInt(full.slice(5, 7), 16)}`;
};
const themeColors = await getBrandingConfig({ accessToken });
const colors = {
  brand: hexToRgbString(themeColors?.brand || '#14b8a6'),
  action: hexToRgbString(themeColors?.action || themeColors?.brand || '#14b8a6'),
  danger: hexToRgbString(themeColors?.danger || '#ef4444'),
  success: hexToRgbString(themeColors?.success || '#22c55e'),
  warning: hexToRgbString(themeColors?.warning || '#f59e0b'),
  info: hexToRgbString(themeColors?.info || '#3b82f6'),
  accent: hexToRgbString(themeColors?.accent || '#ec4899'),
  neutral: hexToRgbString(themeColors?.neutral || '#64748b'),
  overlay: hexToRgbString(themeColors?.overlay || '#0f172a'),
};
const pageTitle = `${initialSong.title || 'Canción'}${initialSong.artist ? ` • ${initialSong.artist}` : ''} | Modo Ensayo`;
---

<!doctype html>
<html lang="es" data-ensayo-route="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20260403" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=20260403" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <style
      is:global
      set:html={`
        html[data-ensayo-route="true"] {
          --bg-background: 248 250 252;
          --bg-surface: 255 255 255;
          --border-base: 226 232 240;
          --text-base: 15 23 42;
          --text-muted: 100 116 139;
          --color-brand: ${colors.brand};
          --color-action: ${colors.action};
          --color-danger: ${colors.danger};
          --color-success: ${colors.success};
          --color-warning: ${colors.warning};
          --color-info: ${colors.info};
          --color-accent: ${colors.accent};
          --color-neutral: ${colors.neutral};
          --color-overlay: ${colors.overlay};
        }
        html[data-ensayo-route="true"].dark {
          --bg-background: 9 9 11;
          --bg-surface: 24 24 27;
          --border-base: 63 63 70;
          --text-base: 250 250 250;
          --text-muted: 161 161 170;
        }
        html, body { margin: 0; background: rgb(var(--bg-background)); }
      `}
    />
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
        } catch {
          // noop
        }
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-hidden bg-white dark:bg-zinc-950">
    <AuthSessionBridge />
    <EnsayoGlobalIsland client:only="react" initialSong={initialSong} exitHref={exitHref} />
  </body>
</html>
