 avatarLockModal?.classList.remove('flex');
 }, 250);
 };

 let cropper: any = (window as any)._cropperInstance || null;
 if (cropper) {
 try {
 cropper.destroy();
 } catch {
 // no-op
 }
 cropper = null;
 (window as any)._cropperInstance = null;
 }

 // Abrir selector de archivos
 on(btnChangeAvatar, 'click', () => {
 if (!canChangeAvatar) {
 openAvatarLockModal();
 return;
 }
 avatarInput?.click();
 });

 // Cuando el usuario selecciona una imagen
 on(avatarInput, 'change', async (e: Event) => {
 if (!canChangeAvatar) return;
 const file = (e.target as HTMLInputElement).files?.[0];
 // Reset input so the same file can be selected again if needed
 avatarInput.value = '';

 if (!file) return;

 setAvatarProcessingState(true);
 pendingProfilePhotoBlob = null;

 try {
 const { blob: safeProfilePhotoBlob, url: safeImageUrl } = await getSafeImageForCropper(file, 1800);
 pendingProfilePhotoBlob = safeProfilePhotoBlob;
 revokePerfilSafeCropperUrl();
 (window as any).__perfilSafeCropperUrl = safeImageUrl;

 if (cropperImage) {
 const waitForImageLoad = new Promise<void>((resolve, reject) => {
 const cleanupImageListeners = () => {
 cropperImage.onload = null;
 cropperImage.onerror = null;
 };

 cropperImage.onload = () => {
 cleanupImageListeners();
 resolve();
 };

 cropperImage.onerror = () => {
 cleanupImageListeners();
 reject(new Error('No se pudo preparar la imagen para el recorte.'));
 };
 });

 cropperImage.src = safeImageUrl;
 cropperImage.classList.remove('hidden');
 if (!cropperImage.complete) {
 await waitForImageLoad;
 }
 openCropperModal();
 }
 } catch (error) {
 pendingProfilePhotoBlob = null;
 console.error('Error al preparar la imagen para el cropper:', error);
 alert(error instanceof Error ? error.message : 'Hubo un problema al cargar la imagen. Intenta con otra más pequeña.');
