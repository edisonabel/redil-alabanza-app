 syncAbsenceDateConstraints({ forceResetEnd: true });
 };

 const closeAbsenceModal = ({ resetDraft = false } = {}) => {
 if (!absenceModal || absenceModal.hidden) return;
 absenceModal.hidden = true;
 document.body.classList.remove('profile-absence-modal-open');
 if (resetDraft) resetAbsenceDraft();
 absenceModalReturnFocus?.focus();
 absenceModalReturnFocus = null;
 };

 const openAbsenceModal = () => {
 if (!absenceModal || btnOpenAbsenceModal?.disabled) return;
 absenceModalReturnFocus = document.activeElement instanceof HTMLElement
 ? document.activeElement
 : btnOpenAbsenceModal;
