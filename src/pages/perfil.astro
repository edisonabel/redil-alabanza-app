 monthYear.textContent = `${parts.month} ${parts.year}`;
 dateBlock.append(dateLabel, day, monthYear);
 return dateBlock;
 };

 const dateConnector = document.createElement('span');
 dateConnector.className = 'profile-absence-date-connector';
 dateConnector.setAttribute('aria-hidden', 'true');
 dateRange.append(
 createDateBlock('Inicio', startDate),
 dateConnector,
 createDateBlock('Fin', endDate),
 );

 const body = document.createElement('div');
 body.className = 'profile-absence-item-body';
 const title = document.createElement('h5');
 title.textContent = String(absence?.motivo || '').trim() || 'Ausencia';
 const dates = document.createElement('p');
 dates.textContent = `${duration} ${duration === 1 ? 'día bloqueado' : 'días bloqueados'}`;
 body.append(title, dates);

 const deleteButton = document.createElement('button');
 deleteButton.type = 'button';
 deleteButton.className = 'profile-absence-delete';
 deleteButton.setAttribute('aria-label', `Eliminar ${title.textContent}, ${formatAbsenceRange(startDate, endDate)}`);
 deleteButton.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"/></svg>';
 on(deleteButton, 'click', () => (window as any)._deleteAusencia(String(absence?.id || '')));

 item.append(dateRange, body, deleteButton);
 ausenciasListEl.appendChild(item);
 });
 };

 syncAbsenceDateConstraints({ forceResetEnd: true });
 on(inputInicio, 'input', () => syncAbsenceDateConstraints({ forceResetEnd: true }));
 on(inputInicio, 'change', () => syncAbsenceDateConstraints({ forceResetEnd: true }));

 const resetAbsenceDraft = () => {
 inputMotivo.value = '';
