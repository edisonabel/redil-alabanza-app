 const profileWizardNav = document.querySelector<HTMLElement>('.profile-wizard-nav');
 const profileWizardStage = document.getElementById('profile-wizard-stage');
 const mobileProfileMedia = window.matchMedia('(max-width: 639px)');
 const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
 let currentProfileStep = 0;

 const syncProfileParallax = () => {
  (window as any).__perfilParallaxFrame = 0;
  if (!profileHeroBackdrop || !mobileProfileMedia.matches || reducedMotionMedia.matches) {
   profileHeroBackdrop?.style.removeProperty('--profile-parallax-y');
   return;
  }

  const hero = document.querySelector<HTMLElement>('.profile-wizard-hero');
  if (!hero) return;
  const scrollProgress = Math.min(hero.offsetHeight, Math.max(0, window.scrollY - hero.offsetTop));
  profileHeroBackdrop.style.setProperty('--profile-parallax-y', `${(scrollProgress * 0.055).toFixed(2)}px`);
 };

 const queueProfileParallax = () => {
  if ((window as any).__perfilParallaxFrame) return;
  (window as any).__perfilParallaxFrame = requestAnimationFrame(syncProfileParallax);
 };

 on(window, 'scroll', queueProfileParallax, { passive: true });
 on(window, 'resize', queueProfileParallax, { passive: true });
 on(mobileProfileMedia, 'change', queueProfileParallax);
 on(reducedMotionMedia, 'change', queueProfileParallax);
 queueProfileParallax();

 const syncProfileHeroBackdrop = (avatarUrl: string | null | undefined) => {
 const safeAvatarUrl = avatarUrl ? toSafeMediaUrl(avatarUrl) : '';
 if (!profileHeroBackdropImage || !profileHeroBackdrop) return;

 if (!safeAvatarUrl) {
 profileHeroBackdropImage.removeAttribute('src');
 profileHeroBackdrop.classList.remove('has-image');
 return;
 }

 profileHeroBackdropImage.src = safeAvatarUrl;
 profileHeroBackdrop.classList.add('has-image');
 };

 const setProfileStep = (requestedStep: number, focusTab = false) => {
 const nextStep = Math.max(0, Math.min(profileWizardPanels.length - 1, requestedStep));
 currentProfileStep = nextStep;

 profileWizardPanels.forEach((panel) => {
 const panelStep = Number(panel.dataset.profilePanel);
 const state = panelStep === nextStep ? 'active' : panelStep < nextStep ? 'before' : 'after';
 const isActive = state === 'active';
 panel.dataset.state = state;
 panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
 panel.toggleAttribute('inert', !isActive);
 if (isActive) panel.scrollTop = 0;
 });

 profileWizardNavItems.forEach((item) => {
 const isActive = Number(item.dataset.profileStep) === nextStep;
 item.setAttribute('aria-selected', isActive ? 'true' : 'false');
 item.tabIndex = isActive ? 0 : -1;
 if (focusTab && isActive) item.focus();
 });

 if (focusTab && mobileProfileMedia.matches && profileWizardNav && profileWizardStage) {
  requestAnimationFrame(() => {
   const navRect = profileWizardNav.getBoundingClientRect();
   if (navRect.top > 2) return;
   const stageTop = profileWizardStage.getBoundingClientRect().top + window.scrollY;
   const targetTop = Math.max(0, stageTop - profileWizardNav.offsetHeight);
   window.scrollTo({
    top: targetTop,
    behavior: reducedMotionMedia.matches ? 'auto' : 'smooth',
   });
  });
 }

 };

 profileWizardNavItems.forEach((item) => {
 on(item, 'click', () => setProfileStep(Number(item.dataset.profileStep), true));
 on(item, 'keydown', (event: Event) => {
 const keyboardEvent = event as KeyboardEvent;
 if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(keyboardEvent.key)) return;
 keyboardEvent.preventDefault();
 if (keyboardEvent.key === 'Home') return setProfileStep(0, true);
 if (keyboardEvent.key === 'End') return setProfileStep(profileWizardPanels.length - 1, true);
 const direction = keyboardEvent.key === 'ArrowRight' ? 1 : -1;
 setProfileStep((currentProfileStep + direction + profileWizardPanels.length) % profileWizardPanels.length, true);
 });
 });

 setProfileStep(0);

