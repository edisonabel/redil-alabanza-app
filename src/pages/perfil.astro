 const syncAvatarControls = () => {
 if (btnChangeAvatar) {
 btnChangeAvatar.disabled = !canChangeAvatar || isPreparingAvatar;
 btnChangeAvatar.classList.toggle('opacity-70', isPreparingAvatar);
 btnChangeAvatar.setAttribute('aria-busy', isPreparingAvatar ? 'true' : 'false');
 }
 if (avatarInput) {
 avatarInput.disabled = !canChangeAvatar || isPreparingAvatar;
 }
 };

 const setAvatarChangeState = (isAllowed: boolean) => {
 canChangeAvatar = isAllowed;
 syncAvatarControls();
 };

 const setAvatarProcessingState = (isBusy: boolean) => {
 isPreparingAvatar = isBusy;
 syncAvatarControls();
 };

 const supportsCanvasMimeType = (mimeType: string): Promise<boolean> => {
 return new Promise((resolve) => {
 const testCanvas = document.createElement('canvas');
 testCanvas.width = 1;
 testCanvas.height = 1;
 testCanvas.toBlob((blob) => resolve(Boolean(blob && blob.type === mimeType)), mimeType, 0.6);
 });
 };

 syncAvatarControls();

