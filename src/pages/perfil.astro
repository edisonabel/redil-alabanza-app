 }

 safeAbsences.forEach((absence: any) => {
 const startDate = String(absence?.fecha_inicio || '');
 const endDate = String(absence?.fecha_fin || '');
 const duration = getAbsenceDuration(startDate, endDate);
 const item = document.createElement('article');
 item.className = 'profile-absence-item';
 item.dataset.ausenciaId = String(absence?.id || '');

 const dateRange = document.createElement('div');
 dateRange.className = 'profile-absence-date-range';
 dateRange.setAttribute('aria-label', `Desde ${formatAbsenceRange(startDate, startDate)} hasta ${formatAbsenceRange(endDate, endDate)}`);

 const createDateBlock = (label: string, dateOnly: string) => {
