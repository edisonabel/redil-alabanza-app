 const formAusencia = document.getElementById('form-ausencia') as HTMLFormElement;
 const btnSaveAusencia = document.getElementById('btn-save-ausencia') as HTMLButtonElement;
 const inputInicio = document.getElementById('ausencia-inicio') as HTMLInputElement;
 const inputFin = document.getElementById('ausencia-fin') as HTMLInputElement;
 const inputMotivo = document.getElementById('ausencia-motivo') as HTMLInputElement;
 const ausenciasListEl = document.getElementById('ausencias-list');
 const absenceModal = document.getElementById('absence-modal') as HTMLElement;
 const absenceDialog = absenceModal?.querySelector('.profile-absence-dialog') as HTMLElement | null;
 const btnOpenAbsenceModal = document.getElementById('btn-open-absence-modal') as HTMLButtonElement;
 const btnCloseAbsenceModal = document.getElementById('btn-close-absence-modal') as HTMLButtonElement;
 let absenceModalReturnFocus: HTMLElement | null = null;
 const absenceDateFormatter = new Intl.DateTimeFormat('en-CA', {
 timeZone: 'America/Bogota',
 year: 'numeric',
 month: '2-digit',
 day: '2-digit',
 });
 const addDaysToDateOnly = (dateOnly: string, amount: number) => {
 const anchor = new Date(`${dateOnly}T12:00:00Z`);
 anchor.setUTCDate(anchor.getUTCDate() + amount);
 return anchor.toISOString().slice(0, 10);
 };
 const absenceMinStartDate = addDaysToDateOnly(absenceDateFormatter.format(new Date()), 7);
 const syncAbsenceDateConstraints = ({ forceResetEnd = false } = {}) => {
 if (inputInicio && !inputInicio.value) inputInicio.value = absenceMinStartDate;
 const nextMinEndDate = inputInicio?.value && inputInicio.value > absenceMinStartDate
 ? inputInicio.value
 : absenceMinStartDate;
 if (inputInicio) inputInicio.min = absenceMinStartDate;
 if (inputFin) inputFin.min = nextMinEndDate;
 if (inputFin && (forceResetEnd || !inputFin.value || inputFin.value < nextMinEndDate)) {
 inputFin.value = nextMinEndDate;
 }
 };

 const parseAbsenceDate = (dateOnly: string) => new Date(`${dateOnly}T12:00:00Z`);
 const absenceRangeFormatter = new Intl.DateTimeFormat('es', {
 timeZone: 'UTC',
 day: 'numeric',
 month: 'short',
 year: 'numeric',
 });

 const getAbsenceDateParts = (dateOnly: string) => {
 const parts = absenceRangeFormatter.formatToParts(parseAbsenceDate(dateOnly));
 return {
 day: parts.find((part) => part.type === 'day')?.value || '',
 month: (parts.find((part) => part.type === 'month')?.value || '').replace('.', '').slice(0, 3),
 year: parts.find((part) => part.type === 'year')?.value || '',
 };
 };

 const formatAbsenceRange = (startDateOnly: string, endDateOnly: string) => {
 const start = getAbsenceDateParts(startDateOnly);
 const end = getAbsenceDateParts(endDateOnly);
 if (startDateOnly === endDateOnly) return `${start.day} ${start.month} ${start.year}`;
 if (start.year === end.year && start.month === end.month) {
 return `${start.day}–${end.day} ${end.month} ${end.year}`;
 }
 if (start.year === end.year) {
 return `${start.day} ${start.month}–${end.day} ${end.month} ${end.year}`;
 }
 return `${start.day} ${start.month} ${start.year}–${end.day} ${end.month} ${end.year}`;
 };

 const getAbsenceDuration = (startDateOnly: string, endDateOnly: string) => {
 const start = parseAbsenceDate(startDateOnly).getTime();
 const end = parseAbsenceDate(endDateOnly).getTime();
 return Math.max(1, Math.round((end - start) / 86_400_000) + 1);
 };

 const renderAbsenceList = (absences: any[]) => {
 if (!ausenciasListEl) return;
 const safeAbsences = Array.isArray(absences) ? absences : [];
 ausenciasListEl.innerHTML = '';

 if (safeAbsences.length === 0) {
 const emptyState = document.createElement('div');
