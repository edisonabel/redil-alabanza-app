 if (vocalUpdate.error) throw vocalUpdate.error;

 // Validación Anti-Fallo Silencioso RLS
 if (!updatedProfile || updatedProfile.length === 0) {
 console.error("Fallo silencioso RLS: Supabase bloqueó la actualización de datos.");
 alert("Error de permisos: No pudimos guardar tu información.");
 throw new Error("Violación de RLS al actualizar datos personales");
 }

 (window as any)._initialTonalidad = vocalVal;
 syncCurrentVoice(vocalVal);
 (window as any)._initialCumpleanos = cumpleanosVal;
 (window as any)._initialTelefono = telefonoVal;
 let feedbackMessage = 'Cambios guardados.';

 if (emailChanged) {
  const emailResponse = await fetch('/api/profile-email', {
   method: 'POST',
   credentials: 'same-origin',
   headers: { 'Content-Type': 'application/json' },
   body: JSON.stringify({ email: correoVal }),
  });
  const emailPayload = await emailResponse.json().catch(() => ({}));

  if (!emailResponse.ok) {
   showProfileFeedback('error', emailPayload?.error || 'Tus datos se guardaron, pero no pudimos iniciar el cambio de correo.');
   checkProfileChanges();
   return;
  }

  (window as any)._initialEmail = correoVal;
  feedbackMessage = emailPayload?.confirmationRequired
   ? 'Cambios guardados. Revisa tu correo para confirmar la nueva dirección.'
   : 'Cambios guardados. Tu correo de acceso fue actualizado.';
 }

 checkProfileChanges();
 showProfileFeedback('success', feedbackMessage);
 } catch (error) {
 console.error("Error al actualizar datos:", error);
 showProfileFeedback('error', 'No se pudieron guardar los cambios. Intenta nuevamente.');
 } finally {
 activeSaveButton.innerHTML = originalBtnHtml;
 activeSaveButton.disabled = false;
 checkProfileChanges();
 }
 });
 }
 
 // Expose delete function to window context for the innerHTML buttons
 (window as any)._deleteAusencia = async (id: string) => {
 if (!confirm('\u00BFEst\u00E1s seguro de eliminar este bloqueo de fechas?')) return;
 
 const row = document.querySelector(`[data-ausencia-id="${id}"]`) as HTMLElement;
 const deleteButton = row?.querySelector('.profile-absence-delete') as HTMLButtonElement | null;
 if (row) row.style.opacity = '0.5';
 if (deleteButton) deleteButton.disabled = true;

 try {
 const { error } = await supabase
 .from('ausencias')
 .delete()
 .eq('id', id);

 if (error) throw error;
 row?.remove();
 
 const remainingAbsences = document.querySelectorAll('[data-ausencia-id]').length;
 if (remainingAbsences === 0) {
 fetchData();
 }

 } catch (err) {
 console.error('Error eliminando ausencia:', err);
 alert("Error eliminando registro.");
 if (row) row.style.opacity = '1';
 if (deleteButton) deleteButton.disabled = false;
 }
 }

 };

 if ((window as any).__perfilPageLoadHandler) {
 document.removeEventListener('astro:page-load', (window as any).__perfilPageLoadHandler);
 }

 if ((window as any).__perfilAfterSwapHandler) {
 document.removeEventListener('astro:after-swap', (window as any).__perfilAfterSwapHandler);
 }

 const onPerfilAfterSwap = () => {
 cleanupPerfilRuntime();
 };

 (window as any).__perfilPageLoadHandler = initPerfilPage;
 (window as any).__perfilAfterSwapHandler = onPerfilAfterSwap;
 document.addEventListener('astro:page-load', initPerfilPage);
 document.addEventListener('astro:after-swap', onPerfilAfterSwap);
</script>
