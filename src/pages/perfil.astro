---
import Layout from '../layouts/Layout.astro';
import OnboardingRoot from '../components/onboarding/OnboardingRoot';
import BotonNotificaciones from '../components/react/BotonNotificaciones.jsx';
import GoogleCalendarConnection from '../components/react/GoogleCalendarConnection.jsx';
import { VOCAL_RANGE_OPTIONS } from '../lib/ministry-config.js';

const userId = Astro.locals.user?.id ?? null;
---

<Layout title="Mi Perfil - Redil">
 <main class="profile-wizard-shell">
 <article class="profile-wizard-panel" aria-labelledby="profile-page-title">
 <header class="profile-wizard-hero" data-tour="perfil-photo">
 <div class="profile-wizard-hero-backdrop" id="profile-hero-backdrop" aria-hidden="true">
 <img id="profile-hero-backdrop-image" alt="" crossorigin="anonymous" />
 </div>
 <div class="profile-wizard-hero-glow" aria-hidden="true"></div>
 <div class="profile-wizard-hero-inner">
 <div class="profile-wizard-media">
 <div class="profile-wizard-portrait-wrap">
 <div id="avatar-container" class="profile-wizard-portrait bg-neutral/20 text-content-muted">
 <svg class="w-8 h-8 animate-pulse" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
 </div>
 </div>
 <button id="btn-change-avatar" class="profile-wizard-photo-button" type="button" title="Cambiar foto" aria-label="Cambiar foto de perfil" disabled>
 <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4 16 6h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3l1.5-2h5Z"/><circle cx="12" cy="13" r="3"/></svg>
 <span>Cambiar foto</span>
 </button>
 <input type="file" id="avatar-input" accept="image/*" class="hidden" />
 </div>

 <div class="profile-wizard-identity">
 <p class="profile-wizard-eyebrow">Mi perfil</p>
 <h1 id="profile-page-title" class="sr-only">Mi Perfil</h1>
 <h2 id="ui-user-name" class="h-8 min-w-[140px] animate-pulse rounded-lg bg-white/15"></h2>
 <p id="ui-user-email" class="h-5 min-w-[180px] animate-pulse rounded-lg bg-white/10"></p>
 <div id="ui-roles-container" class="profile-wizard-roles">
 <div class="h-6 w-16 animate-pulse rounded-full bg-white/10"></div>
 <div class="h-6 w-20 animate-pulse rounded-full bg-white/10"></div>
 </div>
 </div>
 </div>
 </header>

 <nav class="profile-wizard-nav" aria-label="Opciones de Mi Perfil" role="tablist">
 <button type="button" class="profile-wizard-nav-item" data-profile-step="0" role="tab" aria-selected="true" aria-controls="profile-step-data">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
 <span>Datos</span>
 </button>
 <button type="button" class="profile-wizard-nav-item" data-profile-step="1" role="tab" aria-selected="false" aria-controls="profile-step-voice" tabindex="-1">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M9 21h6"/></svg>
 <span>Voz</span>
 </button>
 <button type="button" class="profile-wizard-nav-item" data-profile-step="2" role="tab" aria-selected="false" aria-controls="profile-step-agenda" tabindex="-1">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
 <span>Agenda</span>
 </button>
 <button type="button" class="profile-wizard-nav-item" data-profile-step="3" role="tab" aria-selected="false" aria-controls="profile-step-account" tabindex="-1">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M12 3 4 7v5c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V7l-8-4Z"/><path d="M9 12l2 2 4-4"/></svg>
 <span>Cuenta</span>
 </button>
 </nav>

 <div class="profile-wizard-stage" id="profile-wizard-stage">
 <section id="profile-step-data" class="profile-wizard-step" data-profile-panel="0" data-state="active" role="tabpanel">
 <div class="profile-wizard-step-heading">
 <h3>Datos personales</h3>
 </div>
 <form id="form-datos-personales" class="profile-form-grid">
 <label class="profile-field">
 <span>Nombre completo</span>
 <input type="text" id="input-nombre" disabled placeholder="Cargando..." />
 </label>
 <label class="profile-field">
 <span>Correo de acceso</span>
 <input type="email" id="input-correo" required autocomplete="email" inputmode="email" disabled placeholder="Cargando..." />
 </label>
 <label class="profile-field" data-tour="perfil-birthday">
 <span>Fecha de nacimiento</span>
 <input type="date" id="input-cumpleanos" required disabled />
 </label>
 <label class="profile-field">
 <span>Tel&eacute;fono / WhatsApp</span>
 <input type="tel" id="input-telefono" disabled placeholder="Ej: +123456789" />
 </label>
 </form>
 </section>

 <section id="profile-step-voice" class="profile-wizard-step" data-profile-panel="1" data-state="after" role="tabpanel" aria-hidden="true" inert>
 <div class="profile-wizard-step-heading">
 <h3>Voz</h3>
 </div>
 <div class="profile-voice-section">
 <div class="profile-content-card-heading">
 <span class="profile-feature-icon profile-feature-icon--voice" aria-hidden="true">
 <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 14v4M16 9v14M21 12v8M6 16v1M26 15v2"/><path d="M4 25c3.2 2 7.2 3 12 3s8.8-1 12-3" opacity=".55"/></svg>
 </span>
 <div>
 <h4>Tipo de voz</h4>
 <p>Tu registro vocal actual.</p>
 </div>
 <button id="btn-open-voice-modal" class="profile-voice-change" type="button" aria-label="Cambiar tipo de voz" aria-haspopup="dialog" disabled>
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
 <span>Cambiar voz</span>
 </button>
 </div>
 <h5 class="profile-voice-current-heading">Voz seleccionada</h5>
 <div class="profile-voice-current-card">
 <span class="profile-voice-visual" aria-hidden="true">
 <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 14v4M16 9v14M21 12v8M6 16v1M26 15v2"/><path d="M4 25c3.2 2 7.2 3 12 3s8.8-1 12-3" opacity=".55"/></svg>
 </span>
 <strong id="profile-current-voice">Cargando...</strong>
 </div>
 </div>
 </section>

 <section id="profile-step-agenda" class="profile-wizard-step" data-profile-panel="2" data-state="after" role="tabpanel" aria-hidden="true" inert>
 <div class="profile-wizard-step-heading">
 <h3>Agenda</h3>
 </div>
 <div class="profile-agenda-stack">
 <div class="profile-calendar-slot">
 <GoogleCalendarConnection client:load />
 </div>
 <section class="profile-content-card profile-absence-section" data-tour="perfil-availability">
 <div class="profile-content-card-heading">
 <span class="profile-feature-icon profile-feature-icon--agenda" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
 </span>
 <div>
 <h4>Mis ausencias</h4>
 <p>Fechas en las que no estar&aacute;s disponible.</p>
 </div>
 <button id="btn-open-absence-modal" class="profile-absence-add" type="button" aria-label="Nueva ausencia" aria-haspopup="dialog" disabled>
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
 <span>Nueva ausencia</span>
 </button>
 </div>
 <div class="profile-absence-history">
 <h5>Fechas bloqueadas</h5>
 <div class="profile-absence-list" id="ausencias-list">
 <div class="profile-empty-state">Cargando...</div>
 </div>
 </div>
 </section>
 </div>
 </section>

 <section id="profile-step-account" class="profile-wizard-step" data-profile-panel="3" data-state="after" role="tabpanel" aria-hidden="true" inert>
 <div class="profile-wizard-step-heading">
 <h3>Cuenta</h3>
 </div>
 <div class="profile-account-stack">
 <section class="profile-content-card profile-account-notifications">
 <div class="profile-content-card-heading">
 <span class="profile-feature-icon" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
 </span>
 <div>
 <h4>Notificaciones</h4>
 <p>Recibe avisos importantes en este dispositivo.</p>
 </div>
 <div class="profile-notification-action">
 <BotonNotificaciones client:idle userId={userId} compact profileMode className="profile-notification-control" />
 </div>
 </div>
 </section>
 <section class="profile-content-card profile-account-security">
 <div class="profile-content-card-heading">
 <span class="profile-feature-icon profile-feature-icon--security" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3 4 7v5c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V7l-8-4Z"/><path d="M9 12l2 2 4-4"/></svg>
 </span>
 <div>
 <h4>Seguridad</h4>
 <p>Administra el acceso a tu cuenta.</p>
 </div>
 </div>
 <h5 class="profile-account-actions-heading">Acciones de seguridad</h5>
 <div class="profile-account-actions">
 <button id="btn-change-password" type="button">
 <span class="profile-account-action-icon" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
 </span>
 <span class="profile-account-action-copy">
 <strong>Cambiar contrase&ntilde;a</strong>
 <small>Recibe un enlace seguro por correo.</small>
 </span>
 <svg class="profile-account-action-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
 </button>
 <button id="btn-logout" type="button">
 <span class="profile-account-action-icon" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
 </span>
 <span class="profile-account-action-copy">
 <strong>Cerrar sesi&oacute;n</strong>
 <small>Salir de todos tus dispositivos.</small>
 </span>
 <svg class="profile-account-action-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
 </button>
 </div>
 </section>
 </div>
 </section>
 </div>

 <div class="profile-save-dock" aria-live="polite">
 <button type="submit" id="btn-save-datos" form="form-datos-personales" class="profile-wizard-save hidden">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
 Guardar cambios
 </button>
 </div>

 <div id="profile-feedback" class="profile-feedback" data-tone="success" role="status" aria-live="polite" aria-atomic="true" hidden>
 <span class="profile-feedback-icon" aria-hidden="true">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
 <path class="profile-feedback-success-icon" d="m5 13 4 4L19 7"/>
 <path class="profile-feedback-error-icon" d="m7 7 10 10M17 7 7 17"/>
 </svg>
 </span>
 <p id="profile-feedback-message"></p>
 <button id="profile-feedback-close" type="button" aria-label="Cerrar notificaci&oacute;n">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg>
 </button>
 </div>
 </article>
 </main>

 <div id="absence-modal" class="profile-absence-modal" hidden>
 <div class="profile-absence-dialog" role="dialog" aria-modal="true" aria-labelledby="absence-modal-title" aria-describedby="absence-modal-note">
 <header class="profile-absence-dialog-header">
 <h3 id="absence-modal-title">Nueva ausencia</h3>
 <button id="btn-close-absence-modal" type="button" aria-label="Cerrar">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
 </button>
 </header>
 <form id="form-ausencia" class="profile-absence-form opacity-50 pointer-events-none transition-opacity">
 <div class="profile-absence-date-grid">
 <label class="profile-field profile-absence-date-field">
 <span>Desde</span>
 <input type="date" id="ausencia-inicio" required />
 </label>
 <label class="profile-field profile-absence-date-field">
 <span>Hasta</span>
 <input type="date" id="ausencia-fin" required />
 </label>
 </div>
 <label class="profile-field profile-absence-reason">
 <span>Motivo <em>(opcional)</em></span>
 <input type="text" id="ausencia-motivo" placeholder="Ej. Viaje familiar, trabajo..." />
 </label>
 <p class="profile-content-note" id="absence-modal-note">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
 <span>Registra con al menos 7 d&iacute;as de anticipaci&oacute;n.</span>
 </p>
 <div class="profile-absence-form-footer">
 <button type="submit" id="btn-save-ausencia">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
 <span>Bloquear fechas</span>
 </button>
 </div>
 </form>
 </div>
 </div>

 <div id="voice-modal" class="profile-absence-modal" hidden>
 <div class="profile-absence-dialog profile-voice-dialog" role="dialog" aria-modal="true" aria-labelledby="voice-modal-title">
 <header class="profile-absence-dialog-header">
 <h3 id="voice-modal-title">Cambiar tipo de voz</h3>
 <button id="btn-close-voice-modal" type="button" aria-label="Cerrar">
 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
 </button>
 </header>
 <div class="profile-voice-dialog-body">
 <label class="profile-field profile-voice-field" for="tonalidad-select">
 <span>Tipo de voz</span>
 <select id="tonalidad-select" form="form-datos-personales" disabled>
 <option value="">No soy voz / Todav&iacute;a no lo s&eacute;</option>
 {VOCAL_RANGE_OPTIONS.map((option) => (
 <option value={option.value}>{option.label}</option>
 ))}
 </select>
 </label>
 <button id="btn-save-voice" type="submit" form="form-datos-personales" class="profile-voice-save">
 Guardar voz
 </button>
 </div>
 </div>
 </div>

 <div id="profile-message-modal" class="profile-absence-modal profile-message-modal" data-tone="success" hidden>
 <div class="profile-absence-dialog profile-message-dialog" role="alertdialog" aria-modal="true" aria-labelledby="profile-message-title" aria-describedby="profile-message-text">
 <div class="profile-message-content">
 <span class="profile-message-icon" aria-hidden="true">
 <svg class="profile-message-success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M4 5h16v14H4z"/><path d="m4 7 8 6 8-6"/></svg>
 <svg class="profile-message-error-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
 </span>
 <div>
 <h3 id="profile-message-title">Correo enviado</h3>
 <p id="profile-message-text"></p>
 </div>
 </div>
 <button id="btn-close-profile-message" type="button" class="profile-message-confirm">Entendido</button>
 </div>
 </div>

 <OnboardingRoot client:idle page="perfil" userId={userId} />

 {/* Modal para Recortar Foto */}
 <div id="cropper-modal" class="fixed inset-0 z-50 bg-black/80 hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity opacity-0 duration-300">
 <div id="cropper-content" class="bg-surface rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl scale-95 transition-transform duration-300">
 <div class="px-6 py-4 border-b border-border flex justify-between items-center">
 <h3 class="text-lg font-bold text-content ">Ajustar miniatura</h3>
 <button id="btn-close-cropper" class="text-content-muted hover:text-content-muted dark:text-neutral-200 transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
 </button>
 </div>
 
 <div class="px-6 py-4 bg-blue-50 text-blue-900 border-b border-blue-200 dark:bg-blue-900/40 dark:text-blue-100 dark:border-blue-800 flex items-start gap-3">
 <div class="mt-0.5 text-blue-700 dark:text-blue-200 shrink-0">
 <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
 </div>
 <div class="space-y-1">
 <p class="text-sm font-bold leading-snug">Este recorte se usar&aacute; en las miniaturas</p>
 <p class="text-sm leading-snug text-blue-900 dark:text-blue-100">Centra tu rostro en el c&iacute;rculo. La foto completa, con el espacio alrededor, se guardar&aacute; para el fondo de tu perfil.</p>
 </div>
 </div>

 <div class="p-6 bg-background aspect-square flex items-center justify-center relative">
 <div class="w-full h-full max-h-[60vh] relative z-10">
 <img id="cropper-image" src="" alt="Imagen a recortar" class="max-w-full hidden" />
 </div>
 </div>
 <div class="px-6 py-4 border-t border-border flex justify-end gap-3 bg-background ">
 <button id="btn-cancel-cropper" class="px-5 py-2.5 rounded-xl font-bold text-sm text-content-muted hover:bg-neutral/20 dark:bg-neutral-800 transition-colors">Cancelar</button>
 <button id="btn-save-cropper" class="px-5 py-2.5 rounded-xl font-ui-strong text-sm bg-action hover:bg-action/80 text-white shadow-md transition-all flex items-center gap-2">
 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
 Guardar Foto
 </button>
 </div>
 </div>
 </div>
</Layout>

<div id="avatar-lock-modal" class="fixed inset-0 z-[55] hidden items-center justify-center bg-black/60 p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300">
 <div id="avatar-lock-content" class="w-full max-w-md rounded-[28px] border border-sky-200/80 bg-white shadow-2xl shadow-sky-950/10 transition-transform duration-300 scale-95 dark:border-sky-800/50 dark:bg-surface dark:shadow-black/40">
 <div class="flex items-center justify-between border-b border-border px-6 py-5">
 <div class="flex items-center gap-3">
 <div class="rounded-2xl bg-sky-100 p-2.5 text-sky-700 dark:bg-sky-900/60 dark:text-sky-200">
 <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
 <path d="M12 3a9 9 0 1 0 9 9"></path>
 <path d="M12 7v5l3 3"></path>
 </svg>
 </div>
 <div>
 <h3 class="text-lg font-bold text-content">Cambio de foto de perfil</h3>
 <p class="text-sm text-content-muted">Informacion importante</p>
 </div>
 </div>
 <button id="btn-close-avatar-lock" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-border bg-surface text-content-muted transition-colors hover:text-content hover:bg-background" type="button" aria-label="Cerrar aviso">
 <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
 </button>
 </div>

 <div class="space-y-4 px-6 py-6">
 <p class="rounded-3xl border border-sky-200/80 bg-gradient-to-br from-sky-50 via-white to-amber-50 px-5 py-5 text-sm leading-7 text-slate-700 shadow-sm shadow-sky-100/70 dark:border-sky-800/50 dark:from-sky-950/40 dark:via-surface dark:to-amber-950/10 dark:text-slate-200 dark:shadow-none">
 <strong class="font-bold text-slate-900 dark:text-slate-50">&iexcl;Hola, Dios te bendiga!</strong>
 Para poder <strong class="font-semibold text-slate-900 dark:text-slate-50">identificarte f&aacute;cilmente en el calendario y en las asignaciones</strong>, hemos actualizado tu foto de perfil con una donde
 <strong class="font-semibold text-slate-900 dark:text-slate-50">se ve tu rostro claramente</strong>.
 Si prefieres usar una distinta, <strong class="font-semibold text-slate-900 dark:text-slate-50">&iexcl;no hay problema!</strong>
 Solo env&iacute;ale
 <strong class="font-semibold text-slate-900 dark:text-slate-50">una foto clara de tu rostro al administrador</strong>
 y con gusto la cambiaremos.
 <strong class="font-semibold text-slate-900 dark:text-slate-50">&iexcl;Un abrazo y gracias por tu comprensi&oacute;n!</strong>
 </p>
 </div>

 <div class="flex justify-end border-t border-border px-6 py-5">
 <button id="btn-confirm-avatar-lock" type="button" class="inline-flex min-h-[48px] items-center justify-center rounded-2xl bg-action px-5 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-action/85">
 Entendido
 </button>
