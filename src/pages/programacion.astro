---
import Layout from '../layouts/Layout.astro';
import ModalEvento from '../components/react/ModalEvento.jsx';
import ModalDetalle from '../components/react/ModalDetalle.jsx';
import ModalSerie from '../components/react/ModalSerie.jsx';
import CalendarioGrid from '../components/react/CalendarioGrid.jsx';
import OnboardingRoot from '../components/onboarding/OnboardingRoot';
import { createClient } from '@supabase/supabase-js';
import { getSupabaseServerEnv } from '../lib/server/supabase-env.js';

const INITIAL_MONTH_WINDOW = 2;
const bogotaTodayParts = Object.fromEntries(
  new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/Bogota',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  })
    .formatToParts(new Date())
    .filter((part) => part.type !== 'literal')
    .map((part) => [part.type, part.value])
);
const initialToday = `${bogotaTodayParts.year}-${bogotaTodayParts.month}-${bogotaTodayParts.day}`;

const initialFetchFloor = new Date(Date.now() - 12 * 60 * 60 * 1000);
const initialFetchLimit = new Date(initialFetchFloor);
initialFetchLimit.setMonth(initialFetchLimit.getMonth() + INITIAL_MONTH_WINDOW, 0);
initialFetchLimit.setHours(23, 59, 59, 999);

const accessToken = Astro.locals.accessToken || Astro.cookies.get('sb-access-token')?.value || '';
let ssrUser = Astro.locals.user || null;
let ssrRoles: any[] = [];
let ssrEventos: any[] = [];
let ssrAdmin = false;
let ssrCanEditTema = false;
let ssrHasMoreEventos = false;
let ssrMinistries: any[] = [];
let ssrLeaderMinistryIds: string[] = [];

if (!ssrUser || !accessToken) {
  return Astro.redirect('/login');
}

const { supabaseUrl, supabaseAnonKey } = getSupabaseServerEnv();
const supabaseSSR = createClient(supabaseUrl, supabaseAnonKey, {
  global: {
    headers: {
      Authorization: `Bearer ${accessToken}`,
    },
  },
  auth: {
    persistSession: false,
    autoRefreshToken: false,
  },
});

if (ssrUser) {
  const rolesPromise = supabaseSSR.from('roles').select('id, nombre, codigo').order('nombre');
  const perfilPromise = supabaseSSR.from('perfiles').select('is_admin').eq('id', ssrUser.id).maybeSingle();
  const canEditTemaPromise = supabaseSSR.rpc('has_sermon_edit_role');
  const ministriesPromise = supabaseSSR.from('ministerios').select('id, codigo, nombre').eq('activo', true).order('nombre');
  const leaderMinistriesPromise = supabaseSSR
    .from('perfil_ministerios')
    .select('ministerio_id')
    .eq('perfil_id', ssrUser.id)
    .eq('es_lider', true);
  const eventosPromise = perfilPromise.then(({ data: perfil }) => {
    const isAdmin = perfil?.is_admin || false;

    let query = supabaseSSR
      .from('eventos')
      .select('id, titulo, fecha_hora, hora_fin, estado, es_acustico, notas_especiales, tema_predicacion, serie_id, ministerio_id, ensayo_dia_semana, ensayo_fecha_hora, ministerios(id, codigo, nombre), asignaciones(id, rol_id, perfiles(id, nombre, email, avatar_url, tonalidad_voz))')
      .gte('fecha_hora', initialFetchFloor.toISOString())
      .lte('fecha_hora', initialFetchLimit.toISOString())
      .order('fecha_hora', { ascending: true });

    if (!isAdmin) {
      query = query.eq('estado', 'Publicado');
    }

    return query;
  });
  const moreEventosPromise = perfilPromise.then(({ data: perfil }) => {
    const isAdmin = perfil?.is_admin || false;

    let query = supabaseSSR
      .from('eventos')
      .select('id', { count: 'exact', head: true })
      .gt('fecha_hora', initialFetchLimit.toISOString());

    if (!isAdmin) {
      query = query.eq('estado', 'Publicado');
    }

    return query;
  });

  const [
    { data: globalRoles, error: rolesError },
    { data: perfil, error: perfilError },
    { data: eventosDb, error: err },
    { count: moreEventosCount, error: moreEventosError },
    { data: hasSermonRole },
    { data: ministriesData, error: ministriesError },
    { data: leaderMinistriesData, error: leaderMinistriesError },
  ] = await Promise.all([
    rolesPromise,
    perfilPromise,
    eventosPromise,
    moreEventosPromise,
    canEditTemaPromise,
    ministriesPromise,
    leaderMinistriesPromise,
  ]);

  ssrRoles = globalRoles || [];
  ssrAdmin = perfil?.is_admin || false;
  ssrCanEditTema = ssrAdmin || (hasSermonRole === true);
  ssrHasMoreEventos = (moreEventosCount || 0) > 0;
  ssrMinistries = ministriesData || [];
  ssrLeaderMinistryIds = (leaderMinistriesData || []).map((row) => row.ministerio_id).filter(Boolean);
  const queryError = err || perfilError || rolesError || moreEventosError || ministriesError || leaderMinistriesError;
  if (queryError) {
    console.error('[programacion] SSR query failed', queryError);
  }
  
  ssrEventos = eventosDb || [];
}
---

<Layout>
  <!-- Global inyecciÃ³n de SesiÃ³n SSR Segura para Vanilla JS Scripts posteriores (si quedan) -->
  <script is:inline define:vars={{ ssrUser }}>
    window.__SSR_USER__ = ssrUser;
  </script>

  <div class="max-w-6xl mx-auto px-4 mt-4 md:mt-8 w-full">
    <!-- Encabezado Maestro -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-2 md:gap-4 mb-2 md:mb-6">
      <div>
        <div class="page-title-row">
          <span class="page-title-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
          </span>
          <h1 class="page-title text-[2.1rem] md:text-[3.5rem]">Programaci&oacute;n Mensual</h1>
        </div>
      </div>
    </header>

    <CalendarioGrid
        client:load
        initialEvents={ssrEventos}
        sessionUser={ssrUser}
        initialRoles={ssrRoles}
        isAdmin={ssrAdmin}
        canEditTema={ssrCanEditTema}
        leaderMinistryIds={ssrLeaderMinistryIds}
        initialLoadUntil={initialFetchLimit.toISOString()}
        hasMoreInitialEvents={ssrHasMoreEventos}
        initialToday={initialToday}
    />
    
    <!-- MODAL DE GESTIÃ“N (FASE 1) -->
    <ModalEvento client:only="react" initialMinistries={ssrMinistries} />
    
    <!-- MODAL VISTA DETALLE COMPLETADO (FASE 1) -->
    <ModalDetalle client:only="react" initialRoles={ssrRoles} sessionUser={ssrUser} isAdmin={ssrAdmin} leaderMinistryIds={ssrLeaderMinistryIds} />

    <!-- MODAL GENERADOR DE SERIES -->
    <ModalSerie client:only="react" sessionUser={ssrUser} initialMinistries={ssrMinistries} />
    <OnboardingRoot client:idle page="programacion" userId={ssrUser?.id ?? null} />
  </div>

  <style is:global>
    .programacion-sin-filtros-surface {
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 70%, rgb(191 219 254) 30%);
      border-color: color-mix(in srgb, rgb(var(--border-base)) 58%, rgb(147 197 253) 42%) !important;
    }

    .programacion-sin-filtros-surface:hover {
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 64%, rgb(191 219 254) 36%);
    }

    .programacion-sin-filtros-chip {
      color: color-mix(in srgb, rgb(var(--text-base)) 88%, rgb(30 64 175) 12%);
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 90%, rgb(219 234 254) 10%);
      border: 1px solid color-mix(in srgb, rgb(var(--border-base)) 82%, rgb(147 197 253) 18%);
    }

    .programacion-sin-filtros-chip:hover {
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 86%, rgb(219 234 254) 14%);
    }

    html.dark .programacion-sin-filtros-surface {
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 78%, rgb(30 58 89) 22%);
      border-color: color-mix(in srgb, rgb(var(--border-base)) 76%, rgb(96 165 250) 24%) !important;
    }

    html.dark .programacion-sin-filtros-surface:hover {
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 73%, rgb(30 58 89) 27%);
    }

    html.dark .programacion-sin-filtros-chip {
      color: color-mix(in srgb, rgb(var(--text-base)) 92%, rgb(147 197 253) 8%);
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 93%, rgb(30 58 89) 7%);
      border-color: color-mix(in srgb, rgb(var(--border-base)) 90%, rgb(96 165 250) 10%);
    }

    html.dark .programacion-sin-filtros-chip:hover {
      background-color: color-mix(in srgb, rgb(var(--bg-surface)) 90%, rgb(30 58 89) 10%);
    }

    /* Ocultar scrollbar horizontal en mÃ³vil (mantiene swipe fluÃ­do snap-x) */
    @media (max-width: 767px) {
      .hide-scrollbar-on-mobile::-webkit-scrollbar {
        display: none;
      }
      .hide-scrollbar-on-mobile {
        -ms-overflow-style: none; /* IE and Edge */
        scrollbar-width: none; /* Firefox */
      }
    }

    @media (min-width: 768px) {
      .programacion-card-scroller {
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        scrollbar-width: none;
      }

      .programacion-card-scroller[data-dragging='true'] {
        cursor: grabbing;
        scroll-behavior: auto;
        scroll-snap-type: none;
      }

      .programacion-card-scroller[data-dragging='true'] * {
        cursor: grabbing !important;
      }

      .programacion-card-scroller::-webkit-scrollbar {
        display: none;
      }

      .programacion-scroll-control {
        align-items: center;
        width: min(36rem, calc(100% - 2rem));
        min-height: 26px;
        margin: 0.25rem auto 0;
      }

      .programacion-scroll-control[data-scrollable='false'] {
        display: none;
      }

      .programacion-scroll-control input[type='range'] {
        width: 100%;
        height: 26px;
        margin: 0;
        appearance: none;
        -webkit-appearance: none;
        cursor: ew-resize;
        background: transparent;
      }

      .programacion-scroll-control input[type='range']:focus-visible {
        outline: 2px solid rgb(var(--color-brand));
        outline-offset: 3px;
        border-radius: 999px;
      }

      .programacion-scroll-control input[type='range']::-webkit-slider-runnable-track {
        height: 4px;
        border-radius: 999px;
        background: rgb(var(--border-base) / 0.58);
      }

      .programacion-scroll-control input[type='range']::-webkit-slider-thumb {
        width: 58px;
        height: 10px;
        margin-top: -3px;
        appearance: none;
        -webkit-appearance: none;
        border: 1px solid rgb(var(--border-base));
        border-radius: 999px;
        background: rgb(var(--text-muted) / 0.92);
        box-shadow: 0 1px 4px rgb(var(--text-base) / 0.16);
      }

      .programacion-scroll-control input[type='range']::-moz-range-track {
        height: 4px;
        border-radius: 999px;
        background: rgb(var(--border-base) / 0.58);
      }

      .programacion-scroll-control input[type='range']::-moz-range-thumb {
        width: 58px;
        height: 10px;
        border: 1px solid rgb(var(--border-base));
        border-radius: 999px;
        background: rgb(var(--text-muted) / 0.92);
        box-shadow: 0 1px 4px rgb(var(--text-base) / 0.16);
      }
    }
  </style>
</Layout>
