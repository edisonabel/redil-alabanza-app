<script>
  import { supabase } from '../lib/supabase';
  import { createFetchWithSessionRecovery } from '../utils/authenticatedFetch';

  (() => {
    const existingManager = window.__REDIL_AUTH_MANAGER__;
    if (window.__REDIL_AUTH_SESSION_BRIDGE_INITIALIZED__ && existingManager?.ensureServerSession) {
      void existingManager.ensureServerSession().catch((error: unknown) => {
        console.error('[auth] session resync failed', error);
      });
      return;
    }
    window.__REDIL_AUTH_SESSION_BRIDGE_INITIALIZED__ = true;

    const AUTH_COOKIE_REGEX = /^(sb-|__Host-sb-|__Secure-sb-|supabase-)/i;
    const AUTH_RECOVERY_EXCLUDED_API_PATHS = new Set([
      '/api/auth/session',
      '/api/auth/logout',
      '/api/verify-access-code',
      '/api/registration-avatar',
    ]);
    const SESSION_SYNC_FRESHNESS_MS = 60 * 1000;
    const SESSION_REFRESH_SKEW_SECONDS = 90;
    const nativeFetch = window.fetch.bind(window);
    let sessionSyncPromise: Promise<boolean> | null = null;
    let sessionExpiryPromise: Promise<void> | null = null;
    let lastSessionSyncAt = 0;

    const syncServerSession = async (session: any) => {
      if (!session?.access_token || !session?.refresh_token) return false;
      const response = await nativeFetch('/api/auth/session', {
        method: 'POST',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          access_token: session.access_token,
          refresh_token: session.refresh_token,
        }),
      });

      if (!response.ok) {
        const error = new Error('No se pudo sincronizar la sesion segura.');
        (error as any).status = response.status;
        (error as any).authFailure = response.status === 400 || response.status === 401;
        throw error;
      }

      lastSessionSyncAt = Date.now();
      return true;
    };

    const readFreshClientSession = async ({ refresh = false } = {}) => {
      const current = await supabase.auth.getSession();
      if (current.error) throw current.error;

      const session = current.data?.session || null;
      const expiresAt = Number(session?.expires_at || 0);
      const expiresSoon = expiresAt > 0
        && expiresAt <= Math.floor(Date.now() / 1000) + SESSION_REFRESH_SKEW_SECONDS;

      if (!refresh && !expiresSoon) {
        return session;
      }

      const refreshed = await supabase.auth.refreshSession();
      if (refreshed.error) throw refreshed.error;
      return refreshed.data?.session || null;
    };

    const ensureServerSession = async ({ force = false, refresh = false } = {}) => {
      if (
        !force &&
        !refresh &&
        lastSessionSyncAt > 0 &&
        Date.now() - lastSessionSyncAt < SESSION_SYNC_FRESHNESS_MS
      ) {
        return true;
      }

      if (sessionSyncPromise) {
        const synced = await sessionSyncPromise;
        if (!refresh) return synced;
      }

      sessionSyncPromise = (async () => {
        const session = await readFreshClientSession({ refresh });
        if (!session) return false;
        return syncServerSession(session);
      })().finally(() => {
        sessionSyncPromise = null;
      });

      return sessionSyncPromise;
    };

    const expireCookie = (name: string) => {
      if (!name) return;
      const secureFlag = window.location.protocol === 'https:' ? '; Secure' : '';
      document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 UTC; SameSite=Lax${secureFlag}`;
      document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 UTC; SameSite=None${secureFlag}`;
    };

    const clearSessionCookies = async () => {
      const names = new Set<string>();
      const rawCookies = document.cookie ? document.cookie.split(';') : [];
      rawCookies.forEach((cookiePart) => {
        const [rawName] = cookiePart.trim().split('=');
        if (!rawName) return;
        if (AUTH_COOKIE_REGEX.test(rawName)) {
          names.add(rawName);
        }
      });

      names.forEach((name) => expireCookie(name));

      try {
        Object.keys(localStorage).forEach((key) => {
          if (AUTH_COOKIE_REGEX.test(key) || key.includes('supabase.auth.token')) {
            localStorage.removeItem(key);
          }
        });
      } catch {
        // no-op
      }

      try {
        await nativeFetch('/api/auth/logout', {
          method: 'POST',
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { 'cache-control': 'no-store' },
        });
      } catch {
        // El middleware invalidara cualquier cookie expirada en la siguiente carga.
      }
    };

    const redirectToLogin = () => {
      if (window.location.pathname !== '/login') {
        window.location.assign('/login');
      }
    };

    const expireSession = async ({ reason = 'session-invalid', signOutClient = true } = {}) => {
      if (sessionExpiryPromise) return sessionExpiryPromise;

      sessionExpiryPromise = (async () => {
        console.warn(`[auth] closing unusable session: ${reason}`);
        if (signOutClient) {
          try {
            await supabase.auth.signOut({ scope: 'local' });
          } catch {
            // clearSessionCookies also removes the persisted browser session.
          }
        }
        await clearSessionCookies();
      })().finally(redirectToLogin);

      return sessionExpiryPromise;
    };

    const isDefinitiveAuthError = (error: any) => {
      if (!error) return false;
      if (error.authFailure === true) return true;

      const name = String(error.name || '').toLowerCase();
      const code = String(error.code || '').toLowerCase();
      const message = String(error.message || '').toLowerCase();
      const status = Number(error.status || 0);

      if (
        name.includes('retryable')
        || message.includes('failed to fetch')
        || message.includes('network')
        || message.includes('timeout')
      ) {
        return false;
      }

      return status === 400
        || status === 401
        || code.includes('refresh_token')
        || code === 'session_not_found'
        || code === 'bad_jwt'
        || code === 'user_not_found';
    };

    const shouldRecoverApiRequest = (input: RequestInfo | URL) => {
      try {
        const rawUrl = input instanceof Request ? input.url : String(input);
        const requestUrl = new URL(rawUrl, window.location.href);
        return requestUrl.origin === window.location.origin
          && requestUrl.pathname.startsWith('/api/')
          && !AUTH_RECOVERY_EXCLUDED_API_PATHS.has(requestUrl.pathname);
      } catch {
        return false;
      }
    };

    const fetchWithSessionRecovery = createFetchWithSessionRecovery({
      fetchImpl: nativeFetch,
      ensureServerSession,
      expireSession,
      shouldHandle: shouldRecoverApiRequest,
      isDefinitiveAuthError,
    });

    window.__REDIL_AUTH_MANAGER__ = {
      clearSessionCookies,
      ensureServerSession,
      expireSession,
      fetchWithSessionRecovery,
      syncServerSession,
    };
    window.fetch = fetchWithSessionRecovery;

    const reportSyncFailure = (context: string, error: unknown) => {
      console.error(`[auth] ${context}`, error);
    };

    const syncCurrentSession = (context: string, options = {}) => {
      void ensureServerSession(options)
        .then((synced) => {
          const isAuthView = window.location.pathname === '/login'
            || window.location.pathname === '/reset-password';
          if (!synced && !isAuthView) {
            void expireSession({ reason: 'session-missing-on-resync' });
          }
        })
        .catch((error: unknown) => {
          if (isDefinitiveAuthError(error)) {
            void expireSession({ reason: 'session-resync-rejected' });
            return;
          }
          reportSyncFailure(context, error);
        });
    };

    syncCurrentSession('initial session sync failed', { force: true });

    supabase.auth.onAuthStateChange((event, session) => {
      if ((event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED' || event === 'USER_UPDATED') && session) {
        void syncServerSession(session).catch((error: unknown) => reportSyncFailure('session sync failed', error));
        return;
      }

      if (event === 'INITIAL_SESSION' && session) {
        void syncServerSession(session).catch((error: unknown) => reportSyncFailure('initial session sync failed', error));
        return;
      }

      if (event === 'SIGNED_OUT') {
        void expireSession({ reason: 'supabase-signed-out', signOutClient: false });
      }
    });

    const syncWhenVisible = () => {
      if (document.visibilityState === 'visible') {
        syncCurrentSession('visible session sync failed', { force: true });
      }
    };

    window.addEventListener('pageshow', () => {
      syncCurrentSession('pageshow session sync failed', { force: true });
    });
    window.addEventListener('online', () => {
      syncCurrentSession('online session sync failed', { force: true });
    });
    document.addEventListener('visibilitychange', syncWhenVisible);
  })();
</script>
